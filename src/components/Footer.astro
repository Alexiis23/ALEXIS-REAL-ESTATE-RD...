---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';

const WHATSAPP_PHONE = "18295259993";
const whatsappMsg = isEn
  ? "Hi Alexis, I visited your website and would like personalized real estate advisory."
  : "Hola Alexis, visité tu sitio web y me gustaría asesoría inmobiliaria personalizada.";

const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white/80">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      
      <!-- Brand Column -->
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-white tracking-wide">
          Alexis
          <span class="block text-gold text-sm font-semibold tracking-widest uppercase mt-1">Real Estate RD...</span>
        </h3>
        <p class="text-sm text-white/75 leading-relaxed max-w-xs">
          {isEn 
            ? 'Premium real estate advisory in the Dominican Republic. Apartments, villas, and land in high-growth areas.'
            : 'Asesoría inmobiliaria premium en República Dominicana. Apartamentos, villas y terrenos en zonas de alto crecimiento.'}
        </p>
      </div>

      <!-- Navigation Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-gold uppercase tracking-widest">
          {isEn ? 'Navigation' : 'Navegación'}
        </h4>
        <nav class="flex flex-col gap-2.5">
          <a href={prefix || '/'} class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'Home' : 'Inicio'}
          </a>
          <a href={prefix || '/'} class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'Buy Properties' : 'Comprar Propiedades'}
          </a>
          <a href={isEn ? '/en/rent' : '/alquiler'} class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'Rent a Property' : 'Alquilar Propiedad'}
          </a>
          <a href="/mapa" class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'Property Map' : 'Mapa de Propiedades'}
          </a>
          <a href={isEn ? '/en/about-us' : '/nosotros'} class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'About Us' : 'Nosotros'}
          </a>
          <a href={isEn ? '/en/contact' : '/contacto'} class="text-sm text-white/75 hover:text-gold transition-colors duration-200">
            {isEn ? 'Contact' : 'Contacto'}
          </a>
          <a href={isEn ? '/en/list-with-us' : '/vende-con-nosotros'} class="text-sm text-gold/80 hover:text-gold font-semibold transition-colors duration-200 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            {isEn ? 'List with Us' : 'Vende con Nosotros'}
          </a>
        </nav>
      </div>

      <!-- Contact Column -->
      <div class="space-y-4">
        <h4 class="text-sm font-bold text-gold uppercase tracking-widest">
          {isEn ? 'Contact' : 'Contacto'}
        </h4>
        <div class="space-y-3">
          <a 
            href={`https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(whatsappMsg)}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-all duration-200 shadow-lg shadow-emerald-600/20"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            {isEn ? 'Write us on WhatsApp' : 'Escríbenos por WhatsApp'}
          </a>
          <p class="text-xs text-white/40">
            +1 (829) 525-9993
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/40">
        &copy; {currentYear} Alexis RD Real Estate Properties. {isEn ? 'All rights reserved.' : 'Todos los derechos reservados.'}
      </p>
      <p class="text-xs text-white/30">
        {isEn ? 'Dominican Republic' : 'República Dominicana'}
      </p>
    </div>
  </div>
</footer>
