---
// src/components/guias/BannerWhatsappGuia.astro
interface Props {
  titulo?: string;
  subtitulo?: string;
  badge?: string;
  mensaje?: string;
}

const WHATSAPP_PHONE = "18295259993";

const {
  badge = "Asesoría Gratuita",
  titulo = "¿Deseas verificar un proyecto o la titulación de un terreno?",
  subtitulo = "Evita riesgos legales y confirma si la propiedad cuenta con título deslindado y exenciones fiscales antes de comprometer fondos.",
  mensaje = "Hola Alexis, estoy leyendo la guía de inversión para españoles y me gustaría consultar la disponibilidad de proyectos con Ley Confotur."
} = Astro.props;

const whatsappUrl = `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent(mensaje)}`;
---

<aside class="bg-navy text-white rounded-3xl p-6 sm:p-8 my-10 border border-gold/30 shadow-xl relative overflow-hidden">
  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-center md:text-left space-y-2.5">
      <span class="bg-gold/20 text-gold border border-gold/40 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full inline-block">
        {badge}
      </span>
      <h3 class="text-lg sm:text-xl font-bold tracking-tight text-white !text-white">
        {titulo}
      </h3>
      <p class="text-xs sm:text-sm text-slate-200 !text-slate-200 max-w-xl leading-relaxed font-medium">
        {subtitulo}
      </p>
    </div>

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center gap-2.5 shrink-0 group"
    >
      <svg class="w-4.5 h-4.5 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.96 11.96 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.94 9.94 0 01-5.39-1.587l-.386-.232-3.348 1.122 1.122-3.348-.232-.386A9.94 9.94 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
      </svg>
      <span>Contactar por WhatsApp</span>
    </a>
  </div>
</aside>
