---
// src/components/guias/CajaAlertaJuridica.astro
interface Props {
  titulo: string;
  tipo?: "warning" | "info" | "success";
}

const { titulo, tipo = "warning" } = Astro.props;

const estilos = {
  warning: "bg-amber-500/10 border-amber-500 text-amber-950",
  info: "bg-blue-500/10 border-blue-500 text-navy",
  success: "bg-emerald-500/10 border-emerald-500 text-emerald-950"
};

const iconos = {
  warning: "text-amber-600 bg-amber-100",
  info: "text-blue-600 bg-blue-100",
  success: "text-emerald-600 bg-emerald-100"
};
---

<div class={`border-l-4 rounded-2xl p-5 sm:p-6 my-6 ${estilos[tipo]} shadow-xs`}>
  <div class="flex items-start gap-3.5">
    <div class={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 mt-0.5 ${iconos[tipo]}`}>
      {tipo === "warning" && (
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
      )}
      {tipo === "info" && (
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
      )}
      {tipo === "success" && (
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      )}
    </div>
    <div class="flex-1">
      <h4 class="font-bold text-sm sm:text-base text-navy mb-1.5">{titulo}</h4>
      <div class="text-xs sm:text-sm text-slate-700 font-normal leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>
