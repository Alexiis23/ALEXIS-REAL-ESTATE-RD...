---
// src/components/guias/CajaProyeccionFinanciera.astro
interface Props {
  precioDesde?: string;
  moneda?: string;
  roiMinimo?: number;
  roiMaximo?: number;
}

const {
  precioDesde = "85,000",
  moneda = "USD",
  roiMinimo = 8,
  roiMaximo = 12
} = Astro.props;
---

<div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm my-8">
  <!-- Header -->
  <div class="bg-navy px-5 py-4 sm:px-6">
    <h3 class="text-base sm:text-lg font-bold text-white !text-white flex items-center gap-2.5">
      <svg class="w-5 h-5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
      </svg>
      Proyección Financiera de Inversión en Planos
    </h3>
  </div>

  <div class="p-5 sm:p-6 bg-white space-y-6">

    <!-- Precio referencial -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div>
        <p class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Inversión desde</p>
        <p class="text-2xl sm:text-3xl font-black text-navy mt-1">
          {moneda} ${precioDesde}
        </p>
      </div>
      <div class="bg-gold/10 border border-gold/25 rounded-xl px-4 py-2.5 text-center">
        <p class="text-[10px] text-gold-dark uppercase tracking-wider font-bold">ROI Neto Anual</p>
        <p class="text-xl font-black text-gold mt-0.5">{roiMinimo}% – {roiMaximo}%</p>
      </div>
    </div>

    <!-- Barra de progreso segmentada -->
    <div>
      <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-3">Estructura de Pago en Planos</p>
      <div class="flex h-8 rounded-full overflow-hidden shadow-inner bg-slate-100">
        <!-- Separación / Inicial -->
        <div class="bg-gold flex items-center justify-center text-navy text-[10px] font-extrabold" style="width: 20%;">
          20%
        </div>
        <!-- Durante Construcción -->
        <div class="bg-navy-light flex items-center justify-center text-white text-[10px] font-extrabold" style="width: 50%;">
          50%
        </div>
        <!-- Contra Entrega -->
        <div class="bg-[#25D366] flex items-center justify-center text-white text-[10px] font-extrabold" style="width: 30%;">
          30%
        </div>
      </div>

      <!-- Leyenda -->
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-3">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-gold shrink-0"></span>
          <span class="text-xs text-slate-600"><strong class="text-navy">20%</strong> Separación / Inicial</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-navy-light shrink-0"></span>
          <span class="text-xs text-slate-600"><strong class="text-navy">50%</strong> Durante Construcción</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#25D366] shrink-0"></span>
          <span class="text-xs text-slate-600"><strong class="text-navy">30%</strong> Contra Entrega</span>
        </div>
      </div>
    </div>

    <!-- Desglose detallado -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Card 1 -->
      <div class="bg-gold/[0.06] border border-gold/15 rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-gold/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
            </svg>
          </div>
          <h4 class="text-xs font-bold text-navy uppercase tracking-wide">Separación</h4>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Con solo el <strong class="text-navy">20% del valor total</strong>, reservas tu unidad y congelas el precio de preventa (el más bajo del mercado).
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-navy/[0.03] border border-navy/10 rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-navy/10 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h4 class="text-xs font-bold text-navy uppercase tracking-wide">Construcción</h4>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          El <strong class="text-navy">50% se paga en cuotas mensuales</strong> sin intereses durante el período de construcción (12-36 meses).
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-emerald-50/50 border border-emerald-100 rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h4 class="text-xs font-bold text-navy uppercase tracking-wide">Entrega</h4>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          El <strong class="text-navy">30% restante contra entrega</strong>: financiable con bancos dominicanos (incluso para extranjeros con historial crediticio local).
        </p>
      </div>
    </div>

    <!-- Nota de rentabilidad -->
    <div class="bg-gold/[0.06] border border-gold/20 rounded-xl p-4 flex items-start gap-3">
      <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
      </svg>
      <div>
        <p class="text-xs font-bold text-navy">¿Cómo se calcula el ROI del {roiMinimo}% – {roiMaximo}%?</p>
        <p class="text-xs text-slate-500 mt-1 leading-relaxed">
          Basado en rentas vacacionales cortas (Airbnb/Booking) en destinos como Punta Cana, Bávaro y Cap Cana. La rentabilidad neta incluye descontar gastos de property management (~20-25% de la renta bruta), mantenimiento y servicios. Las cifras corresponden a promedios del mercado dominicano en 2025-2026.
        </p>
      </div>
    </div>
  </div>
</div>
