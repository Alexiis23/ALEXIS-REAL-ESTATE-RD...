---
// src/components/guias/IndiceContenido.astro
interface ItemIndice {
  id: string;
  titulo: string;
  tipoIcono: 'doc' | 'pen' | 'shield' | 'bank' | 'money' | 'chart';
}

const items: ItemIndice[] = [
  { id: "requisitos", titulo: "1. Requisitos para Españoles", tipoIcono: "doc" },
  { id: "poder-consular", titulo: "2. Firma a Distancia (Poder)", tipoIcono: "pen" },
  { id: "titulo-deslindado", titulo: "3. Título Deslindado (Seguridad)", tipoIcono: "shield" },
  { id: "divisas-bancos", titulo: "4. Envío de Divisas (EUR a USD)", tipoIcono: "bank" },
  { id: "ley-confotur", titulo: "5. Ahorro Fiscal (Ley Confotur)", tipoIcono: "money" },
  { id: "rentabilidad-roi", titulo: "6. Gestión de Rentas y ROI", tipoIcono: "chart" }
];
---

<nav class="bg-white border border-slate-200 rounded-3xl p-6 mb-10 shadow-sm">
  <div class="flex items-center gap-2.5 mb-4 text-navy font-bold text-sm uppercase tracking-wider">
    <div class="w-7 h-7 rounded-lg bg-gold/15 flex items-center justify-center text-gold">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
      </svg>
    </div>
    <span>Contenido de esta Guía</span>
  </div>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-semibold text-slate-700">
    {items.map((item) => (
      <a
        href={`#${item.id}`}
        class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-50/80 hover:bg-gold/10 hover:text-navy hover:border-gold/30 transition-all border border-slate-100 group"
      >
        <span class="w-6 h-6 rounded-lg bg-white flex items-center justify-center text-gold group-hover:text-gold-dark shadow-2xs shrink-0 border border-slate-100">
          {item.tipoIcono === 'doc' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          )}
          {item.tipoIcono === 'pen' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
            </svg>
          )}
          {item.tipoIcono === 'shield' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          )}
          {item.tipoIcono === 'bank' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.5m-15 10.5V10.5M3 21h18M3 9h18" />
            </svg>
          )}
          {item.tipoIcono === 'money' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          )}
          {item.tipoIcono === 'chart' && (
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" />
            </svg>
          )}
        </span>
        <span class="truncate">{item.titulo}</span>
      </a>
    ))}
  </div>
</nav>
