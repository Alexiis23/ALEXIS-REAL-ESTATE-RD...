---
// src/components/guias/TablaComparativaFiscal.astro
// Tabla visual comparativa: Régimen Ordinario vs Ley Confotur 158-01
---

<div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm my-10">
  <!-- Header -->
  <div class="bg-navy px-5 py-4 sm:px-6">
    <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2.5">
      <svg class="w-5 h-5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5" />
      </svg>
      Comparativa Fiscal: Régimen Ordinario vs. Ley Confotur 158-01
    </h3>
  </div>

  <!-- Tabla responsive -->
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="text-left px-5 py-3.5 font-bold text-navy text-xs uppercase tracking-wider">Concepto Fiscal</th>
          <th class="text-center px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-slate-600">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-red-400"></span>
              Régimen Ordinario
            </span>
          </th>
          <th class="text-center px-4 py-3.5 font-bold text-xs uppercase tracking-wider text-navy">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-gold"></span>
              Ley Confotur 158-01
            </span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <!-- Fila 1: Impuesto de Transferencia -->
        <tr class="hover:bg-slate-50/50 transition-colors">
          <td class="px-5 py-4">
            <div class="font-semibold text-navy">Impuesto de Transferencia</div>
            <div class="text-xs text-slate-400 mt-0.5">DGII — al momento de la compraventa</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-red-50 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full border border-red-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              3% del valor
            </span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Exento 100%
            </span>
          </td>
        </tr>

        <!-- Fila 2: IPI Anual -->
        <tr class="hover:bg-slate-50/50 transition-colors">
          <td class="px-5 py-4">
            <div class="font-semibold text-navy">IPI (Impuesto Patrimonio Inmobiliario)</div>
            <div class="text-xs text-slate-400 mt-0.5">Anual — propiedades &gt; RD$9.86 MM</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-red-50 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full border border-red-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              1% anual
            </span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Exento 15 años
            </span>
          </td>
        </tr>

        <!-- Fila 3: Ganancia de Capital -->
        <tr class="hover:bg-slate-50/50 transition-colors">
          <td class="px-5 py-4">
            <div class="font-semibold text-navy">Ganancia de Capital (ISR)</div>
            <div class="text-xs text-slate-400 mt-0.5">Al revender la propiedad</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-red-50 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full border border-red-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              27% ISR
            </span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Exento 15 años
            </span>
          </td>
        </tr>

        <!-- Fila 4: ITBIS -->
        <tr class="hover:bg-slate-50/50 transition-colors">
          <td class="px-5 py-4">
            <div class="font-semibold text-navy">ITBIS (IVA Dominicano)</div>
            <div class="text-xs text-slate-400 mt-0.5">Sobre materiales de construcción</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-red-50 text-red-600 text-xs font-bold px-3 py-1.5 rounded-full border border-red-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
              18% ITBIS
            </span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-full border border-emerald-100">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Exento 100%
            </span>
          </td>
        </tr>

        <!-- Fila 5: Duración del beneficio -->
        <tr class="bg-gold/[0.04]">
          <td class="px-5 py-4">
            <div class="font-semibold text-navy">Duración Total del Beneficio</div>
            <div class="text-xs text-slate-400 mt-0.5">Desde la emisión de la resolución Confotur</div>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="text-xs text-slate-400 font-medium">No aplica</span>
          </td>
          <td class="px-4 py-4 text-center">
            <span class="inline-flex items-center gap-1.5 bg-gold/15 text-gold-dark text-xs font-bold px-3 py-1.5 rounded-full border border-gold/25">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
              15 años de exención
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Footer: Disclaimer -->
  <div class="bg-slate-50 border-t border-slate-200 px-5 py-3.5">
    <p class="text-[11px] text-slate-400 leading-relaxed">
      <strong class="text-slate-500">Nota legal:</strong> La información fiscal contenida en esta tabla es de carácter orientativo y está basada en la legislación vigente de la República Dominicana al momento de su redacción. Para confirmar la elegibilidad Confotur de un proyecto específico, consulta con un abogado inmobiliario o directamente con el <strong class="text-slate-500">Consejo de Fomento Turístico (Confotur)</strong>.
    </p>
  </div>
</div>
