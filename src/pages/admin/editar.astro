                <!-- Previews nuevas -->
                <div id="newGalleryPreviewsGrid" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 gap-3"></div>
              </div>
            </div>
          </section>

          <!-- ═══ CONFIRMACIÓN Y GUARDADO ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">Confirmar Modificaciones</h2>
                <p class="text-white/50 text-xs">Autenticación requerida para persistir cambios</p>
              </div>
            </div>

            <div class="p-8 space-y-6">
              <div>
                <label class="pub-label">Contraseña de Administrador <span class="text-gold">*</span></label>
                <input
                  type="password"
                  id="adminPasswordInput"
                  required
                  placeholder="Ingrese la contraseña de seguridad..."
                  class="pub-input max-w-md"
                />
              </div>

              <!-- Barra de progreso -->
              <div id="editProgressContainer" class="hidden space-y-2">
                <div class="flex justify-between items-center text-xs font-bold text-navy uppercase tracking-wider">
                  <span id="editProgressStatus">Guardando cambios...</span>
                  <span id="editProgressPercent">0%</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                  <div id="editProgressBar" class="bg-gold h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <p id="editProgressMsg" class="text-xs text-slate-500 italic">Optimizando imágenes...</p>
              </div>

              <!-- Feedback -->
              <div id="feedbackSuccess" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-5 py-4 text-sm font-semibold">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <p class="font-bold">¡Cambios guardados con éxito!</p>
                    <p id="successDetail" class="text-xs font-normal mt-0.5 text-emerald-700"></p>
                    <a id="successLink" href={`/propiedades/${propiedad.slug}`} target="_blank" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 hover:text-emerald-900 mt-2 underline">
                      Ver propiedad actualizada
                    </a>
                  </div>
                </div>
              </div>

              <div id="feedbackError" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4 text-sm font-semibold">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div id="errorMsg">Algo salió mal.</div>
                </div>
              </div>

              <!-- Botón Guardar -->
              <button
                type="submit"
                id="btnSaveEdit"
                class="w-full bg-navy hover:bg-navy-light text-white font-bold py-4 rounded-xl text-sm uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2.5 shadow-lg shadow-navy/20 hover:shadow-navy/30 group disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              >
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
                </svg>
                Guardar Todos los Cambios
              </button>
            </div>
          </section>
        </form>
      )}
    </main>

    <Footer lang="es" />
    <AccessibilityWidget lang="es" />

    <!-- ─── SCRIPT DEL CLIENTE ─────────────────────────── -->
    <script is:inline>
      // Utilidad de compresión WebP
      async function comprimirFoto(file, maxWidth = 1920, calidad = 0.82) {
        return new Promise((resolve) => {
          if (file.type === "image/webp" && file.size < 350 * 1024) {
            return resolve(file);
          }
          const reader = new FileReader();
          reader.readAsDataURL(file);
          reader.onload = (e) => {
            const img = new Image();
            img.src = e.target.result;
            img.onload = () => {
              const canvas = document.createElement("canvas");
              let width = img.width;
              let height = img.height;
              if (width > maxWidth) {
                height = Math.round((height * maxWidth) / width);
                width = maxWidth;
              }
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, width, height);
              canvas.toBlob(
                (blob) => {
                  const nombreLimpio = file.name.replace(/\.[^/.]+$/, "") + ".webp";
                  resolve(new File([blob], nombreLimpio, { type: "image/webp" }));
                },
                "image/webp",
                calidad
              );
            };
          };
        });
      }

      // Subir archivo individual a Vercel Blob reutilizando endpoint existente
      async function subirABlob(file, propertySlug, password) {
        const fd = new FormData();
        fd.append("mode", "blob");
        fd.append("propertySlug", propertySlug);
        fd.append("adminPassword", password);
        fd.append("foto", file);

        const res = await fetch("/api/subir-galeria", {
          method: "POST",
          body: fd,
        });
        const json = await res.json();
        if (!res.ok || !json.success) {
          throw new Error(json.error || "Error al subir imagen a Vercel Blob.");
        }
        return json.url;
      }

      function initEditor() {
        const form = document.getElementById("editPropertyForm");
        if (!form || form.dataset.listenerAttached) return;
        form.dataset.listenerAttached = "true";

        const slug = form.getAttribute("data-slug") || "";
        let existingGallery = JSON.parse(form.getAttribute("data-galeria-inicial") || "[]");
        let currentCoverUrl = form.getAttribute("data-portada-inicial") || "";

        let newCoverFile = null;
        let newGalleryFiles = [];

        // DOM elements
        const existingGalleryGrid = document.getElementById("existingGalleryGrid");
        const emptyExistingMsg = document.getElementById("emptyExistingMsg");
        const galleryStats = document.getElementById("galleryStats");

        const editCoverDropzone = document.getElementById("editCoverDropzone");
        const editCoverInput = document.getElementById("editCoverInput");
        const currentCoverImg = document.getElementById("currentCoverImg");
        const coverChangeNotice = document.getElementById("coverChangeNotice");

        const editGalleryDropzone = document.getElementById("editGalleryDropzone");
        const editGalleryInput = document.getElementById("editGalleryInput");
        const newGalleryPreviewsGrid = document.getElementById("newGalleryPreviewsGrid");

        const btnSave = document.getElementById("btnSaveEdit");
        const adminPasswordInput = document.getElementById("adminPasswordInput");
        const progressContainer = document.getElementById("editProgressContainer");
        const progressBar = document.getElementById("editProgressBar");
        const progressPercent = document.getElementById("editProgressPercent");
        const progressStatus = document.getElementById("editProgressStatus");
        const progressMsg = document.getElementById("editProgressMsg");

        const feedbackSuccess = document.getElementById("feedbackSuccess");
        const successDetail = document.getElementById("successDetail");
        const feedbackError = document.getElementById("feedbackError");
        const errorMsg = document.getElementById("errorMsg");

        // ── RENDER FOTOS EXISTENTES ──
        function renderExistingGallery() {
          if (!existingGalleryGrid) return;
          existingGalleryGrid.innerHTML = "";
          galleryStats.textContent = `${existingGallery.length} guardadas`;

          if (existingGallery.length === 0) {
            emptyExistingMsg?.classList.remove("hidden");
          } else {
            emptyExistingMsg?.classList.add("hidden");
          }

          existingGallery.forEach((item, idx) => {
            const previewUrl = typeof item === "string" ? item : (item.preview || item.raw);
            const card = document.createElement("div");
            card.className = "pub-gallery-card";
            card.innerHTML = `
              <img src="${previewUrl}" class="w-full h-full object-cover" alt="Foto ${idx + 1}" loading="lazy" />
              <button type="button" class="pub-gallery-remove" data-idx="${idx}" title="Eliminar foto">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
              <span class="pub-gallery-index">${idx + 1}</span>
            `;
            card.querySelector("button").addEventListener("click", (e) => {
              e.stopPropagation();
              existingGallery.splice(idx, 1);
              renderExistingGallery();
            });
            existingGalleryGrid.appendChild(card);
          });
        }

        renderExistingGallery();

        // ── NUEVA PORTADA ──
        editCoverDropzone.addEventListener("click", () => editCoverInput.click());

        editCoverDropzone.addEventListener("dragover", (e) => {
          e.preventDefault();
          editCoverDropzone.classList.add("pub-dropzone-active");
        });
        editCoverDropzone.addEventListener("dragleave", () => {
          editCoverDropzone.classList.remove("pub-dropzone-active");
        });
        editCoverDropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          editCoverDropzone.classList.remove("pub-dropzone-active");
          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            setNewCoverFile(e.dataTransfer.files[0]);
          }
        });

        editCoverInput.addEventListener("change", () => {
          if (editCoverInput.files && editCoverInput.files[0]) {
            setNewCoverFile(editCoverInput.files[0]);
          }
        });

        function setNewCoverFile(file) {
          newCoverFile = file;
          currentCoverImg.src = URL.createObjectURL(file);
          coverChangeNotice.classList.remove("hidden");
        }

        // ── NUEVAS FOTOS DE GALERÍA ──
        editGalleryDropzone.addEventListener("click", () => editGalleryInput.click());

        editGalleryDropzone.addEventListener("dragover", (e) => {
          e.preventDefault();
          editGalleryDropzone.classList.add("pub-dropzone-active");
        });
        editGalleryDropzone.addEventListener("dragleave", () => {
          editGalleryDropzone.classList.remove("pub-dropzone-active");
        });
        editGalleryDropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          editGalleryDropzone.classList.remove("pub-dropzone-active");
          if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            addNewGalleryFiles(Array.from(e.dataTransfer.files));
          }
        });

        editGalleryInput.addEventListener("change", () => {
          if (editGalleryInput.files) {
            addNewGalleryFiles(Array.from(editGalleryInput.files));
          }
        });

        function addNewGalleryFiles(files) {
          newGalleryFiles = [...newGalleryFiles, ...files.filter((f) => f.type.startsWith("image/"))];
          renderNewGalleryPreviews();
        }

        function renderNewGalleryPreviews() {
          newGalleryPreviewsGrid.innerHTML = "";
          newGalleryFiles.forEach((file, index) => {
            const card = document.createElement("div");
            card.className = "pub-gallery-card border-gold/50";
            card.innerHTML = `
              <img src="${URL.createObjectURL(file)}" class="w-full h-full object-cover" alt="Nueva ${index + 1}" />
              <button type="button" class="pub-gallery-remove" data-index="${index}">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
              <span class="pub-gallery-index bg-gold text-slate-950">+${index + 1}</span>
            `;
            card.querySelector("button").addEventListener("click", (e) => {
              e.stopPropagation();
              newGalleryFiles.splice(index, 1);
              renderNewGalleryPreviews();
            });
            newGalleryPreviewsGrid.appendChild(card);
          });
        }

        // ── GUARDAR CAMBIOS ──
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          const password = adminPasswordInput.value;
          if (!password) {
            showError("Ingresa la contraseña de administrador.");
            return;
          }

          feedbackSuccess.classList.add("hidden");
          feedbackError.classList.add("hidden");
          btnSave.setAttribute("disabled", "true");
          btnSave.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Guardando...';
          progressContainer.classList.remove("hidden");

          const stepsCount = (newCoverFile ? 1 : 0) + newGalleryFiles.length + 1;
          let currentStep = 0;

          function updateProgress(text, detail) {
            currentStep++;
            const pct = Math.round((currentStep / stepsCount) * 100);
            progressBar.style.width = pct + "%";
            progressPercent.textContent = pct + "%";
            progressStatus.textContent = text;
            if (detail) progressMsg.textContent = detail;
          }

          try {
            const formData = new FormData(form);
            let finalCoverUrl = currentCoverUrl;

            // 1. Subir nueva portada si se seleccionó
            if (newCoverFile) {
              updateProgress("Subiendo portada...", "Optimizando nueva foto de portada a WebP...");
              const coverOpt = await comprimirFoto(newCoverFile, 1920, 0.82);
              finalCoverUrl = await subirABlob(coverOpt, slug, password);
            }

            // 2. Subir nuevas fotos de galería
            const newUploadedUrls = [];
            for (let i = 0; i < newGalleryFiles.length; i++) {
              updateProgress(
                `Subiendo foto ${i + 1}/${newGalleryFiles.length}`,
                `Optimizando: ${newGalleryFiles[i].name}`
              );
              const opt = await comprimirFoto(newGalleryFiles[i], 1920, 0.82);
              const url = await subirABlob(opt, slug, password);
              newUploadedUrls.push(url);
            }

            // 3. Combinar galería existente con nuevas fotos
            const existingRawUrls = existingGallery.map((item) => typeof item === "string" ? item : (item.raw || item.preview));
            const finalGaleria = [...existingRawUrls, ...newUploadedUrls];

            // 4. Actualizar en backend
            updateProgress("Sincronizando...", "Guardando los cambios de la propiedad...");

            const payload = {
              slug,
              password,
              titulo: formData.get("titulo"),
              descripcion: formData.get("descripcion"),
              titulo_en: formData.get("titulo_en"),
              descripcion_en: formData.get("descripcion_en"),
              precioUsd: formData.get("precioUsd"),
              precioDop: formData.get("precioDop"),
              regimen: formData.get("regimen"),
              tipo: formData.get("tipo"),
              estado: formData.get("estado"),
              habitaciones: formData.get("habitaciones"),
              banos: formData.get("banos"),
              parqueos: formData.get("parqueos"),
              area: formData.get("area"),
              confotur: formData.get("confotur") === "on",
              exclusiva: formData.get("exclusiva") === "on",
              ubicacion: formData.get("ubicacion"),
              latitud: formData.get("latitud"),
              longitud: formData.get("longitud"),
              tipoVideo: formData.get("tipoVideo"),
              videoUrl: formData.get("videoUrl"),
              imagenPrincipal: finalCoverUrl,
              galeria: finalGaleria,
            };

            const res = await fetch("/api/propiedades/actualizar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            const result = await res.json();
            if (!res.ok || !result.success) {
              throw new Error(result.error || "Error al actualizar la propiedad.");
            }

            // Éxito
            progressBar.style.width = "100%";
            progressPercent.textContent = "100%";
            progressStatus.textContent = "Completado";
            progressMsg.textContent = "¡Cambios guardados con éxito!";

            successDetail.textContent = `La propiedad "${formData.get("titulo")}" fue actualizada con ${finalGaleria.length} foto(s) de galería.`;
            feedbackSuccess.classList.remove("hidden");
            feedbackSuccess.scrollIntoView({ behavior: "smooth", block: "nearest" });

            // Actualizar estado interno
            existingGallery = finalGaleria;
            currentCoverUrl = finalCoverUrl;
            newCoverFile = null;
            newGalleryFiles = [];
            coverChangeNotice.classList.add("hidden");
            newGalleryPreviewsGrid.innerHTML = "";
            renderExistingGallery();

          } catch (error) {
            showError(error.message);
          } finally {
            btnSave.removeAttribute("disabled");
            btnSave.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg> Guardar Todos los Cambios';
            setTimeout(() => {
              progressContainer.classList.add("hidden");
              progressBar.style.width = "0%";
              progressPercent.textContent = "0%";
            }, 4000);
          }
        });

        function showError(msg) {
          errorMsg.textContent = msg;
          feedbackError.classList.remove("hidden");
          feedbackError.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      }

      document.addEventListener("DOMContentLoaded", initEditor);
      document.addEventListener("astro:page-load", initEditor);
    </script>
  </body>
