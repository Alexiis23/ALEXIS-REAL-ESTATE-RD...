---
// src/pages/admin/editar.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityWidget from "../../components/AccessibilityWidget.astro";
import { getEntry } from "astro:content";
import type { ImageMetadata } from "astro";

export const prerender = false;

// Resolver imágenes locales de assets
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP,JPG,PNG}",
  { eager: true },
);

function resolverImagen(imgRaw: string | undefined): string {
  if (!imgRaw) return "";
  if (imgRaw.startsWith("http://") || imgRaw.startsWith("https://") || imgRaw.startsWith("/")) {
    return imgRaw;
  }
  const rutaPublica = imgRaw.replace(/^\.\.\/\.\.\//, "/src/");
  const meta = imagenes[rutaPublica]?.default;
  return meta ? meta.src : imgRaw;
}

const slug = Astro.url.searchParams.get("slug") || "";
let propiedad: any = null;

if (slug) {
  const entry = await getEntry("propiedades", slug);
  if (entry) {
    const rawGaleria = Array.isArray(entry.data.galeria) ? entry.data.galeria : [];
    const resolvedGaleria = rawGaleria.map((g: any) => resolverImagen(String(g || "")));

    propiedad = {
      slug: entry.id,
      titulo: entry.data.titulo || entry.id.replace(/-/g, " "),
      descripcion: entry.data.descripcion || "",
      titulo_en: entry.data.titulo_en || "",
      descripcion_en: entry.data.descripcion_en || "",
      precioUsd: Number(entry.data.precioUsd) || 0,
      precioDop: Number(entry.data.precioDop) || 0,
      regimen: entry.data.regimen || "Venta",
      tipo: entry.data.tipo || "Apartamento",
      estado: entry.data.estado || "En planos",
      habitaciones: Number(entry.data.habitaciones) || 0,
      banos: Number(entry.data.banos) || 0,
      parqueos: Number(entry.data.parqueos) || 0,
      area: Number(entry.data.area) || 0,
      confotur: Boolean(entry.data.confotur),
      exclusiva: Boolean(entry.data.exclusiva),
      ubicacion: entry.data.ubicacion || "",
      latitud: Number(entry.data.latitud) || 0,
      longitud: Number(entry.data.longitud) || 0,
      tipoVideo: entry.data.tipoVideo || "recorrido-virtual",
      videoUrl: entry.data.videoUrl || "",
      imagenPrincipal: resolverImagen(entry.data.imagenPrincipal),
      rawImagenPrincipal: entry.data.imagenPrincipal || "",
      galeria: resolvedGaleria,
      rawGaleria: rawGaleria,
    };
  }
}
---

<!doctype html>
<html lang="es" class="bg-offwhite text-slate-900">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {propiedad ? `Editar: ${propiedad.titulo}` : "Editor de Inmuebles"} | Alexis RD Real Estate
    </title>
    <meta
      name="description"
      content="Edición integral de datos técnicos, portada y gestión de galería fotográfica."
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar lang="es" currentPage="admin-editar" />

    <!-- ─── HERO ADMINISTRATIVO ─────────────────────────── -->
    <section class="relative overflow-hidden pt-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"
      ></div>
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"
      ></div>
      <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-gold/8 rounded-full blur-3xl pointer-events-none"
      ></div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <a
              href="/admin"
              class="inline-flex items-center gap-2 text-xs font-bold text-white/60 hover:text-white bg-white/10 hover:bg-white/15 px-3.5 py-1.5 rounded-xl transition-all mb-4"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              Volver al Panel Central
            </a>
            <h1 class="text-2xl sm:text-3xl font-black text-white leading-tight tracking-tight">
              {propiedad ? `Editar: ` : "Editor Integral de "}
              <span class="text-gold">{propiedad ? propiedad.titulo : "Inmuebles"}</span>
            </h1>
            <p class="mt-1 text-white/60 text-xs sm:text-sm">
              Modifica datos comerciales, sustituye la portada o gestiona fotos de la galería en tiempo real.
            </p>
          </div>

          {propiedad && (
            <div class="flex items-center gap-2">
              <a
                href={`/propiedades/${propiedad.slug}`}
                target="_blank"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-300 hover:text-white bg-white/10 hover:bg-white/20 px-4 py-2.5 rounded-xl transition-all"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                Ver Ficha Pública
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ─── CONTENIDO PRINCIPAL ─────────────────────────── -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
      {!propiedad ? (
        <div class="bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 p-12 text-center space-y-4">
          <div class="w-14 h-14 bg-gold/15 text-gold rounded-2xl flex items-center justify-center mx-auto">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-navy">No se especificó ninguna propiedad válida</h2>
          <p class="text-xs text-slate-500 max-w-md mx-auto">
            Por favor, regresa al panel de control y selecciona una propiedad del catálogo para editarla.
          </p>
          <div class="pt-2">
            <a
              href="/admin"
              class="inline-flex items-center gap-2 bg-navy hover:bg-navy-light text-white text-xs font-bold uppercase tracking-wider px-6 py-3 rounded-xl transition-all"
            >
              Ir al Catálogo de Propiedades
            </a>
          </div>
        </div>
      ) : (
        <form
          id="editPropertyForm"
          class="space-y-8"
          data-slug={propiedad.slug}
          data-galeria-inicial={JSON.stringify(
            (propiedad.rawGaleria || []).map((raw: string, idx: number) => ({
              raw,
              preview: propiedad.galeria[idx] || raw,
            }))
          )}
          data-portada-inicial={propiedad.rawImagenPrincipal || ""}
        >
          <!-- ═══ MÓDULO 1: INFORMACIÓN GENERAL ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">1. Información General</h2>
                <p class="text-white/50 text-xs">Título y descripción del inmueble</p>
              </div>
            </div>

            <div class="p-8 space-y-5">
              <div>
                <label class="pub-label">Título del Inmueble (Español) <span class="text-gold">*</span></label>
                <input
                  type="text"
                  name="titulo"
                  value={propiedad.titulo}
                  required
                  minlength="5"
                  class="pub-input"
                />
              </div>
              <div>
                <label class="pub-label">Descripción Detallada (Español)</label>
                <textarea
                  name="descripcion"
                  rows="4"
                  class="pub-input"
                >{propiedad.descripcion}</textarea>
              </div>

              <!-- Traducción Inglés -->
              <div class="pt-4 border-t border-slate-100 space-y-4">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                  Traducción en Inglés (Opcional)
                </p>
                <div>
                  <label class="pub-label">Title (English)</label>
                  <input
                    type="text"
                    name="titulo_en"
                    value={propiedad.titulo_en}
                    placeholder="Property title in English"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Description (English)</label>
                  <textarea
                    name="descripcion_en"
                    rows="3"
                    placeholder="Property description in English"
                    class="pub-input"
                  >{propiedad.descripcion_en}</textarea>
                </div>
              </div>
            </div>
          </section>

          <!-- ═══ MÓDULO 2: DATOS COMERCIALES ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">2. Precios y Especificaciones</h2>
                <p class="text-white/50 text-xs">Datos comerciales, tipo y dimensiones físicas</p>
              </div>
            </div>

            <div class="p-8 space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                  <label class="pub-label">Precio USD ($)</label>
                  <input
                    type="number"
                    name="precioUsd"
                    value={propiedad.precioUsd}
                    placeholder="285000"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Precio DOP (RD$)</label>
                  <input
                    type="number"
                    name="precioDop"
                    value={propiedad.precioDop}
                    placeholder="17000000"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Tipo de Transacción</label>
                  <select name="regimen" class="pub-input">
                    <option value="Venta" selected={propiedad.regimen === "Venta"}>Venta (Comprar)</option>
                    <option value="Alquiler" selected={propiedad.regimen === "Alquiler"}>Alquiler (Renta)</option>
                  </select>
                </div>
                <div>
                  <label class="pub-label">Tipo de Propiedad</label>
                  <select name="tipo" class="pub-input">
                    {["Apartamento", "Villa", "Casa", "Solar", "Hotel"].map((t) => (
                      <option value={t} selected={propiedad.tipo === t}>{t}</option>
                    ))}
                  </select>
                </div>
              </div>

              <!-- Estado y specs -->
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div>
                  <label class="pub-label">Estado</label>
                  <select name="estado" class="pub-input">
                    <option value="En planos" selected={propiedad.estado === "En planos"}>En planos</option>
                    <option value="En construcción" selected={propiedad.estado === "En construcción"}>En construcción</option>
                    <option value="Listo" selected={propiedad.estado === "Listo"}>Listo para entrega</option>
                  </select>
                </div>
                <div>
                  <label class="pub-label">Habitaciones</label>
                  <input
                    type="number"
                    name="habitaciones"
                    value={propiedad.habitaciones}
                    min="0"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Baños</label>
                  <input
                    type="number"
                    name="banos"
                    value={propiedad.banos}
                    min="0"
                    step="0.5"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Parqueos</label>
                  <input
                    type="number"
                    name="parqueos"
                    value={propiedad.parqueos}
                    min="0"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Área (m²)</label>
                  <input
                    type="number"
                    name="area"
                    value={propiedad.area}
                    min="0"
                    class="pub-input"
                  />
                </div>
              </div>

              <!-- Checkboxes -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <label class="pub-checkbox">
                  <input
                    type="checkbox"
                    name="confotur"
                    checked={propiedad.confotur}
                    class="w-4 h-4 accent-gold rounded"
                  />
                  <div>
                    <span class="pub-checkbox-title">Beneficio Ley Confotur (158-01)</span>
                    <span class="pub-checkbox-desc">Exime del 3% DGII y 1% de IPI anual.</span>
                  </div>
                </label>
                <label class="pub-checkbox">
                  <input
                    type="checkbox"
                    name="exclusiva"
                    checked={propiedad.exclusiva}
                    class="w-4 h-4 accent-gold rounded"
                  />
                  <div>
                    <span class="pub-checkbox-title">Propiedad en Exclusiva</span>
                    <span class="pub-checkbox-desc">Muestra el pin exacto en el mapa.</span>
                  </div>
                </label>
              </div>
            </div>
          </section>

          <!-- ═══ MÓDULO 3: UBICACIÓN Y VIDEO ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">3. Ubicación y Video Tour</h2>
                <p class="text-white/50 text-xs">GPS y recorrido virtual</p>
              </div>
            </div>

            <div class="p-8 space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="pub-label">Ubicación de Referencia</label>
                  <input
                    type="text"
                    name="ubicacion"
                    value={propiedad.ubicacion}
                    placeholder="Ej. Bávaro, Punta Cana"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Latitud (GPS)</label>
                  <input
                    type="number"
                    step="any"
                    name="latitud"
                    value={propiedad.latitud}
                    placeholder="18.5601"
                    class="pub-input"
                  />
                </div>
                <div>
                  <label class="pub-label">Longitud (GPS)</label>
                  <input
                    type="number"
                    step="any"
                    name="longitud"
                    value={propiedad.longitud}
                    placeholder="-68.3725"
                    class="pub-input"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="pub-label">Tipo de Video</label>
                  <select name="tipoVideo" class="pub-input">
                    <option value="recorrido-virtual" selected={propiedad.tipoVideo === "recorrido-virtual"}>Recorrido Virtual General</option>
                    <option value="dron-terreno" selected={propiedad.tipoVideo === "dron-terreno"}>Vista Aérea con Dron</option>
                    <option value="tour-villa" selected={propiedad.tipoVideo === "tour-villa"}>Video Tour de Villa / Casa</option>
                    <option value="tour-apartamento" selected={propiedad.tipoVideo === "tour-apartamento"}>Presentación de Apartamento</option>
                    <option value="proyecto-amenidades" selected={propiedad.tipoVideo === "proyecto-amenidades"}>Residencial y Amenidades</option>
                  </select>
                </div>
                <div>
                  <label class="pub-label">Enlace de YouTube</label>
                  <input
                    type="url"
                    name="videoUrl"
                    value={propiedad.videoUrl}
                    placeholder="https://youtu.be/..."
                    class="pub-input"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- ═══ MÓDULO 4: FOTO DE PORTADA ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">4. Foto Principal (Portada)</h2>
                <p class="text-white/50 text-xs">Portada actual y reemplazo</p>
              </div>
            </div>

            <div class="p-8">
              <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
                <div class="relative shrink-0">
                  <img
                    id="currentCoverImg"
                    src={propiedad.imagenPrincipal || "/placeholder-property.jpg"}
                    class="w-48 h-32 object-cover rounded-2xl border-2 border-gold/40 shadow-md bg-slate-100"
                    alt="Portada actual"
                  />
                  <span class="absolute bottom-2 left-2 bg-navy/80 text-white text-[9px] font-bold px-2 py-0.5 rounded-md">
                    Actual
                  </span>
                </div>

                <div class="flex-1 w-full">
                  <div
                    id="editCoverDropzone"
                    class="pub-dropzone py-6"
                  >
                    <input type="file" id="editCoverInput" accept="image/*" class="hidden" />
                    <div class="space-y-1">
                      <svg class="w-8 h-8 mx-auto text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      <p class="text-xs font-semibold text-navy">Haz clic o arrastra para reemplazar la portada</p>
                      <p class="text-[11px] text-slate-400">Solo si deseas cambiar la foto actual (se optimizará a WebP)</p>
                    </div>
                  </div>
                  <p id="coverChangeNotice" class="hidden text-xs font-bold text-emerald-700 mt-2 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Nueva portada seleccionada (se subirá al guardar).
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- ═══ MÓDULO 5: GALERÍA DE FOTOS ═══ -->
          <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
            <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
              <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-base">5. Galería de Fotos</h2>
                <p class="text-white/50 text-xs">Administra las fotos actuales y añade nuevas</p>
              </div>
              <div class="ml-auto">
                <span id="galleryStats" class="text-gold text-[10px] font-bold uppercase tracking-wider">
                  {propiedad.galeria.length} guardadas
                </span>
              </div>
            </div>

            <div class="p-8 space-y-6">
              <!-- Fotos existentes -->
              <div>
                <p class="text-xs font-bold text-navy uppercase tracking-wider mb-3">
                  Fotos Actuales en Galería
                  <span class="text-slate-400 font-normal text-[11px] lowercase">(haz clic en la ✕ roja para quitar cualquier foto):</span>
                </p>
                <div id="existingGalleryGrid" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 gap-3"></div>
                <p id="emptyExistingMsg" class="hidden text-xs text-slate-400 italic py-3">No hay fotos en la galería actualmente.</p>
              </div>

              <!-- Añadir nuevas fotos -->
