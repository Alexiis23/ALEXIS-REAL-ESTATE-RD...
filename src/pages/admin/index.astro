  .dash-metric-label {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
  }
  .dash-metric-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 900;
    color: white;
    line-height: 1.2;
    margin-top: 0.125rem;
  }
  .dash-metric-sub {
    display: block;
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 0.125rem;
  }

  /* ── Table ── */
  .dash-table-head {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .dash-table-row {
    transition: background-color 0.15s ease;
  }
  .dash-table-row:hover {
