  }
  body.a11y-dark-mode .dash-table-row td {
    color: #cbd5e1 !important;
  }
  body.a11y-dark-mode .dash-table-row p.font-bold {
    color: #f1f5f9 !important;
  }
  body.a11y-dark-mode .dash-type-badge {
    background-color: #1b304c !important;
    color: #e2e8f0 !important;
  }
  body.a11y-dark-mode .dash-photo-badge {
    background-color: #1b304c !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
    color: #94a3b8 !important;
  }
  body.a11y-dark-mode .dash-action-view {
    background-color: #1b304c !important;
