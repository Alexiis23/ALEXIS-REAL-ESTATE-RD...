    transition: all 0.2s ease;
  }
  .dash-btn-primary:hover {
    background-color: #b5953f;
    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.4);
  }
  .dash-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
