---
// src/pages/admin/index.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityWidget from "../../components/AccessibilityWidget.astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

export const prerender = false;

// Resolver imágenes locales de assets
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP,JPG,PNG}",
  { eager: true },
);

function resolverImagen(imgRaw: string | undefined): string {
  if (!imgRaw) return "";
  if (imgRaw.startsWith("http://") || imgRaw.startsWith("https://") || imgRaw.startsWith("/")) {
    return imgRaw;
  }
  const rutaPublica = imgRaw.replace(/^\.\.\/\.\.\//, "/src/");
  const meta = imagenes[rutaPublica]?.default;
  return meta ? meta.src : imgRaw;
}

const propiedadesRaw = await getCollection("propiedades");
const propiedades = propiedadesRaw
  .map((p) => ({
    slug: p.id,
    titulo: p.data.titulo || p.id.replace(/-/g, " "),
    tipo: p.data.tipo || "Inmueble",
    regimen: p.data.regimen || "Venta",
    precioUsd: Number(p.data.precioUsd) || 0,
    precioDop: Number(p.data.precioDop) || 0,
    ubicacion: p.data.ubicacion || "República Dominicana",
    imagenPrincipal: resolverImagen(p.data.imagenPrincipal),
    totalFotos:
      (Array.isArray(p.data.galeria) ? p.data.galeria.length : 0) +
      (p.data.imagenPrincipal ? 1 : 0),
    confotur: Boolean(p.data.confotur),
    exclusiva: Boolean(p.data.exclusiva),
  }))
  .reverse();

const totalInmuebles = propiedades.length;
const totalConfotur = propiedades.filter((p) => p.confotur).length;
const totalExclusivas = propiedades.filter((p) => p.exclusiva).length;

// Formatear precio
function formatPrecio(p: (typeof propiedades)[0]) {
  if (p.precioUsd > 0) return `$${p.precioUsd.toLocaleString("en-US")}`;
  if (p.precioDop > 0) return `RD$${p.precioDop.toLocaleString("en-US")}`;
  return "Consultar";
}
---

<!doctype html>
<html lang="es" class="bg-offwhite text-slate-900">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Centro de Control | Alexis RD Real Estate - Consola de Administración
    </title>
    <meta
      name="description"
      content="Dashboard administrativo para gestionar el catálogo de propiedades inmobiliarias."
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar lang="es" currentPage="admin" />

    <!-- ─── HERO ADMINISTRATIVO ─────────────────────────── -->
    <section class="relative overflow-hidden pt-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"
      ></div>
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"
      ></div>
      <div
        class="absolute top-0 left-1/3 w-96 h-96 bg-gold/8 rounded-full blur-3xl pointer-events-none"
      ></div>

      <div
        class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div>
            <span
              class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-3"
            >
              Centro de Control
            </span>
            <h1
              class="text-3xl sm:text-4xl font-black text-white leading-tight tracking-tight"
            >
              Gestión <span class="text-gold">Inmobiliaria</span>
            </h1>
            <p class="mt-2 text-white/60 text-sm max-w-lg">
              Administra el catálogo completo de propiedades, imágenes y
              publicaciones desde un solo lugar.
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <a
              href="/"
              target="_blank"
              class="dash-btn-secondary"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              Ver Web
            </a>
            <a
              href="/admin/publicar"
              class="dash-btn-primary"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Publicar Inmueble
            </a>
            <button
              type="button"
              id="btnLogoutGlobal"
              class="text-xs font-bold text-red-400 hover:text-red-300 bg-red-950/30 hover:bg-red-950/60 border border-red-800/40 px-3.5 py-2 rounded-xl transition-all cursor-pointer"
            >
              Cerrar Sesión ✕
            </button>
          </div>
        </div>

        <!-- ─── TARJETAS MÉTRICAS ─────────────────────────── -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-10">
          <div class="dash-metric-card">
            <div class="dash-metric-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <div>
              <span class="dash-metric-label">Total en Catálogo</span>
              <span class="dash-metric-value">{totalInmuebles}</span>
              <span class="dash-metric-sub">Propiedades activas</span>
            </div>
          </div>
          <div class="dash-metric-card">
            <div class="dash-metric-icon dash-metric-icon-gold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <div>
              <span class="dash-metric-label text-gold">Con Ley Confotur</span>
              <span class="dash-metric-value text-gold">{totalConfotur}</span>
              <span class="dash-metric-sub">Exentas de impuestos</span>
            </div>
          </div>
          <div class="dash-metric-card">
            <div class="dash-metric-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
            </div>
            <div>
              <span class="dash-metric-label">En Exclusiva</span>
              <span class="dash-metric-value">{totalExclusivas}</span>
              <span class="dash-metric-sub">Captaciones directas</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── TABLA DE INVENTARIO ─────────────────────────── -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <section
        class="dash-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden"
      >
        <div
          class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
          <div class="flex items-center gap-4">
            <div
              class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0"
            >
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">Catálogo de Propiedades</h2>
              <p class="text-white/50 text-xs">
                Selecciona cualquier inmueble para editar datos o gestionar fotos.
              </p>
            </div>
          </div>
          <div class="w-full sm:w-72">
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input
                type="text"
                id="searchTableInput"
                placeholder="Filtrar por título, zona o tipo..."
                class="w-full bg-white/10 border border-white/15 rounded-xl pl-9 pr-3 py-2 text-xs text-white placeholder:text-white/40 focus:outline-none focus:border-gold/50"
              />
            </div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="dash-table-head">
                <th class="py-3.5 px-6">Inmueble</th>
                <th class="py-3.5 px-4">Tipo</th>
                <th class="py-3.5 px-4">Precio</th>
                <th class="py-3.5 px-4">Fotos</th>
                <th class="py-3.5 px-4">Badges</th>
                <th class="py-3.5 px-6 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                propiedades.map((p) => (
                  <tr
                    class="property-row dash-table-row"
                    data-search={`${p.titulo} ${p.ubicacion} ${p.tipo} ${p.slug}`.toLowerCase()}
                  >
                    <td class="py-3.5 px-6">
                      <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-lg overflow-hidden border border-slate-200 bg-slate-50 shrink-0">
                          {p.imagenPrincipal ? (
                            <img
                              src={p.imagenPrincipal}
                              alt={p.titulo}
                              class="w-full h-full object-cover"
                              loading="lazy"
                            />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center">
                              <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                          )}
                        </div>
                        <div class="min-w-0 max-w-[220px]">
                          <p class="font-bold text-navy truncate text-xs">{p.titulo}</p>
                          <p class="text-[10px] text-slate-400 truncate">{p.ubicacion}</p>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="dash-type-badge">{p.tipo}</span>
                      <span class="block text-[10px] text-slate-400 mt-0.5">{p.regimen}</span>
                    </td>
                    <td class="py-3.5 px-4 font-bold text-navy text-xs">
                      {formatPrecio(p)}
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="dash-photo-badge">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        {p.totalFotos}
                      </span>
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="flex flex-wrap gap-1">
                        {p.confotur && (
                          <span class="dash-badge-confotur">CONFOTUR</span>
                        )}
                        {p.exclusiva && (
                          <span class="dash-badge-exclusiva">EXCLUSIVA</span>
                        )}
                      </div>
                    </td>
                    <td class="py-3.5 px-6 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <a
                          href={`/propiedades/${p.slug}`}
                          target="_blank"
                          class="dash-action-view"
                        >
                          Ver
                        </a>
                        <a
                          href={`/admin/editar?slug=${encodeURIComponent(p.slug)}`}
                          class="dash-action-edit"
                        >
                          Editar
                        </a>
                      </div>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Sin resultados -->
        <div id="noResults" class="hidden text-center py-12 px-6">
          <svg class="w-10 h-10 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <p class="text-sm font-semibold text-slate-500">No se encontraron propiedades</p>
          <p class="text-xs text-slate-400 mt-1">Intenta con otro término de búsqueda.</p>
        </div>
      </section>
    </main>

    <Footer lang="es" />
    <AccessibilityWidget lang="es" />

    <!-- ─── SCRIPT DE FILTRADO ─────────────────────────── -->
    <script is:inline>
      function setupTableFilter() {
        const input = document.getElementById("searchTableInput");
        const rows = document.querySelectorAll(".property-row");
        const noResults = document.getElementById("noResults");

        if (!input) return;
        if (input.dataset.listenerAttached) return;
        input.dataset.listenerAttached = "true";

        input.addEventListener("input", () => {
          const query = input.value
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .trim();

          let visible = 0;
          rows.forEach((row) => {
            const text = (row.getAttribute("data-search") || "")
              .normalize("NFD")
              .replace(/[\u0300-\u036f]/g, "");
            const match = text.includes(query);
            row.style.display = match ? "" : "none";
            if (match) visible++;
          });

          if (noResults) {
            noResults.classList.toggle("hidden", visible > 0);
          }
        });
      }

      document.addEventListener("DOMContentLoaded", setupTableFilter);
      document.addEventListener("astro:page-load", setupTableFilter);
    </script>
  </body>
</html>

<style is:global>
  /* ── Dashboard Buttons ── */
  .dash-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0b192c;
    background-color: #c9a84c;
    padding: 0.625rem 1.25rem;
    border-radius: 0.75rem;
