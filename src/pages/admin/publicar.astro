---
// src/pages/admin/publicar.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityWidget from "../../components/AccessibilityWidget.astro";

export const prerender = false;
---

<!doctype html>
<html lang="es" class="bg-offwhite text-slate-900">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Publicar Propiedad | Alexis RD Real Estate - Consola de Administración
    </title>
    <meta
      name="description"
      content="Publique propiedades completas con datos, portada y galería en un solo paso."
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar lang="es" currentPage="admin-publicar" />

    <!-- ─── HERO ADMINISTRATIVO ─────────────────────────── -->
    <section class="relative overflow-hidden pt-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"
      ></div>
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"
      ></div>
      <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-gold/8 rounded-full blur-3xl pointer-events-none"
      ></div>

      <div
        class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 text-center"
      >
        <span
          class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-4"
        >
          Panel Inmobiliario
        </span>
        <h1
          class="text-3xl sm:text-4xl font-black text-white leading-tight tracking-tight"
        >
          Publicador Unificado de <span class="text-gold">Propiedades</span>
        </h1>
        <p class="mt-3 text-white/70 max-w-2xl mx-auto text-sm leading-relaxed">
          Completa la ficha técnica, portada y galería fotográfica en un solo
          paso. Las imágenes se optimizan automáticamente a WebP antes de subirse
          a Vercel Blob.
        </p>
        <div class="mt-4 flex items-center justify-center gap-3">
          <a
            href="/admin/subir-fotos"
            class="text-xs text-white/50 hover:text-white border border-white/15 hover:border-white/30 px-4 py-2 rounded-xl transition-all"
          >
            Cargador de Galería Independiente
          </a>
        </div>
      </div>
    </section>

    <!-- ─── FORMULARIO PRINCIPAL ─────────────────────────── -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
      <form id="publishForm" class="space-y-8">

        <!-- ═══ MÓDULO 1: INFORMACIÓN GENERAL ═══ -->
        <section
          class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden"
        >
          <div
            class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4"
          >
            <div
              class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0"
            >
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">1. Información General</h2>
              <p class="text-white/50 text-xs">Título y descripción del inmueble</p>
            </div>
          </div>

          <div class="p-8 space-y-5">
            <div>
              <label class="pub-label">Título del Inmueble (Español) <span class="text-gold">*</span></label>
              <input
                type="text"
                name="titulo"
                required
                minlength="5"
                placeholder="Ej. Exclusiva Villa de Lujo en Punta Cana con Piscina"
                class="pub-input"
              />
            </div>
            <div>
              <label class="pub-label">Descripción Detallada (Español)</label>
              <textarea
                name="descripcion"
                rows="4"
                placeholder="Detalla las amenidades, acabados, cercanía a la playa y facilidades de pago..."
                class="pub-input"
              ></textarea>
            </div>

            <!-- Traducción Inglés -->
            <div class="pt-4 border-t border-slate-100 space-y-4">
              <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                Traducción en Inglés (Opcional)
              </p>
              <div>
                <label class="pub-label">Title (English)</label>
                <input type="text" name="titulo_en" placeholder="Property title in English" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Description (English)</label>
                <textarea name="descripcion_en" rows="3" placeholder="Property description in English" class="pub-input"></textarea>
              </div>
            </div>
          </div>
        </section>

        <!-- ═══ MÓDULO 2: DATOS COMERCIALES ═══ -->
        <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">2. Datos Comerciales y Características</h2>
              <p class="text-white/50 text-xs">Precios, tipo y especificaciones físicas</p>
            </div>
          </div>

          <div class="p-8 space-y-5">
            <!-- Precios y régimen -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
              <div>
                <label class="pub-label">Precio USD ($)</label>
                <input type="number" name="precioUsd" placeholder="285000" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Precio DOP (RD$)</label>
                <input type="number" name="precioDop" placeholder="17000000" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Tipo de Transacción</label>
                <select name="regimen" class="pub-input">
                  <option value="Venta">Venta (Comprar)</option>
                  <option value="Alquiler">Alquiler (Renta)</option>
                </select>
              </div>
              <div>
                <label class="pub-label">Tipo de Propiedad</label>
                <select name="tipo" class="pub-input">
                  <option value="Apartamento">Apartamento</option>
                  <option value="Villa">Villa</option>
                  <option value="Casa">Casa</option>
                  <option value="Solar">Solar / Terreno</option>
                  <option value="Hotel">Hotel</option>
                </select>
              </div>
            </div>

            <!-- Estado y specs -->
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
              <div>
                <label class="pub-label">Estado</label>
                <select name="estado" class="pub-input">
                  <option value="En planos">En planos</option>
                  <option value="En construcción">En construcción</option>
                  <option value="Listo">Listo para entrega</option>
                </select>
              </div>
              <div>
                <label class="pub-label">Habitaciones</label>
                <input type="number" name="habitaciones" value="0" min="0" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Baños</label>
                <input type="number" name="banos" value="0" min="0" step="0.5" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Parqueos</label>
                <input type="number" name="parqueos" value="0" min="0" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Área (m²)</label>
                <input type="number" name="area" placeholder="120" min="0" class="pub-input" />
              </div>
            </div>

            <!-- Checkboxes -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <label class="pub-checkbox">
                <input type="checkbox" name="confotur" class="w-4 h-4 accent-gold rounded" />
                <div>
                  <span class="pub-checkbox-title">Beneficio Ley Confotur (158-01)</span>
                  <span class="pub-checkbox-desc">Exime del 3% DGII y 1% de IPI anual.</span>
                </div>
              </label>
              <label class="pub-checkbox">
                <input type="checkbox" name="exclusiva" class="w-4 h-4 accent-gold rounded" />
                <div>
                  <span class="pub-checkbox-title">Propiedad en Exclusiva</span>
                  <span class="pub-checkbox-desc">Muestra el pin exacto en el mapa.</span>
                </div>
              </label>
            </div>
          </div>
        </section>

        <!-- ═══ MÓDULO 3: UBICACIÓN Y VIDEO ═══ -->
        <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">3. Ubicación y Video Tour</h2>
              <p class="text-white/50 text-xs">Coordenadas GPS y recorrido virtual</p>
            </div>
          </div>

          <div class="p-8 space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="pub-label">Ubicación de Referencia</label>
                <input type="text" name="ubicacion" placeholder="Ej. Bávaro, Punta Cana" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Latitud (GPS)</label>
                <input type="number" step="any" name="latitud" placeholder="18.5601" class="pub-input" />
              </div>
              <div>
                <label class="pub-label">Longitud (GPS)</label>
                <input type="number" step="any" name="longitud" placeholder="-68.3725" class="pub-input" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="pub-label">Tipo de Video</label>
                <select name="tipoVideo" class="pub-input">
                  <option value="recorrido-virtual">Recorrido Virtual General</option>
                  <option value="dron-terreno">Vista Aérea con Dron</option>
                  <option value="tour-villa">Video Tour de Villa / Casa</option>
                  <option value="tour-apartamento">Presentación de Apartamento</option>
                  <option value="proyecto-amenidades">Residencial y Amenidades</option>
                </select>
              </div>
              <div>
                <label class="pub-label">Enlace de YouTube</label>
                <input type="url" name="videoUrl" placeholder="https://youtu.be/..." class="pub-input" />
              </div>
            </div>
          </div>
        </section>

        <!-- ═══ MÓDULO 4: FOTO DE PORTADA ═══ -->
        <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">4. Foto Principal (Portada)</h2>
              <p class="text-white/50 text-xs">Imagen destacada del inmueble</p>
            </div>
            <div class="ml-auto">
              <span class="text-gold text-[10px] font-bold uppercase tracking-wider">Requerida *</span>
            </div>
          </div>

          <div class="p-8">
            <div
              id="coverDropzone"
              class="pub-dropzone"
            >
              <input type="file" id="coverInput" accept="image/*" class="hidden" />
              <div id="coverPlaceholder" class="space-y-2">
                <svg class="w-10 h-10 mx-auto text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="text-sm font-semibold text-navy">Arrastra o haz clic para seleccionar la portada</p>
                <p class="text-xs text-slate-400">Se optimizará automáticamente a WebP</p>
              </div>
              <div id="coverPreviewContainer" class="hidden relative inline-block" style="display:none;">
                <img id="coverPreviewImg" src="data:," class="max-w-xs h-40 object-cover rounded-xl border-2 border-gold/40" alt="Portada" />
                <button type="button" id="btnRemoveCover" class="absolute -top-2 -right-2 bg-red-500 hover:bg-red-600 text-white rounded-full w-7 h-7 text-xs font-bold shadow-lg flex items-center justify-center transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- ═══ MÓDULO 5: GALERÍA DE FOTOS ═══ -->
        <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">5. Galería de Fotos</h2>
              <p class="text-white/50 text-xs">Subida masiva con optimización WebP</p>
            </div>
            <div class="ml-auto">
              <span id="galleryCount" class="text-gold/70 text-[10px] font-bold uppercase tracking-wider">0 fotos</span>
            </div>
          </div>

          <div class="p-8 space-y-4">
            <div id="galleryDropzone" class="pub-dropzone">
              <input type="file" id="galleryInput" accept="image/*" multiple class="hidden" />
              <div class="space-y-2">
                <svg class="w-10 h-10 mx-auto text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <p class="text-sm font-semibold text-navy">Arrastra aquí las fotografías de la galería</p>
                <p class="text-xs text-slate-400">Puedes seleccionar múltiples archivos (JPG, PNG, WebP)</p>
              </div>
            </div>

            <!-- Grid de previews -->
            <div id="galleryPreviewsGrid" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 gap-3"></div>
          </div>
        </section>

        <!-- ═══ CONTRASEÑA + BARRA DE PROGRESO + BOTÓN ═══ -->
        <section class="pub-section bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-5 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-white font-bold text-base">Confirmación y Publicación</h2>
              <p class="text-white/50 text-xs">Autenticación administrativa requerida</p>
            </div>
          </div>

          <div class="p-8 space-y-6">
            <div>
              <label class="pub-label">Contraseña de Administrador <span class="text-gold">*</span></label>
              <input
                type="password"
                id="adminPassword"
                name="adminPassword"
                required
                placeholder="Ingrese la contraseña de seguridad..."
                class="pub-input"
              />
            </div>

            <!-- Barra de progreso -->
            <div id="progressContainer" class="hidden space-y-2">
              <div class="flex justify-between items-center text-xs font-bold text-navy uppercase tracking-wider">
                <span id="progressStatus">Procesando...</span>
                <span id="progressPercent">0%</span>
              </div>
              <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div id="progressBar" class="bg-gold h-full rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
              <p id="progressMsg" class="text-xs text-slate-500 italic">Preparando imágenes...</p>
            </div>

            <!-- Feedback -->
            <div id="feedbackSuccess" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-5 py-4 text-sm font-semibold">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <p class="font-bold">Propiedad publicada con éxito</p>
                  <p id="successDetail" class="text-xs font-normal mt-0.5 text-emerald-700"></p>
                  <a id="successLink" href="#" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 hover:text-emerald-900 mt-2 underline">
                    Ver propiedad publicada
                  </a>
                </div>
              </div>
            </div>

            <div id="feedbackError" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4 text-sm font-semibold">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div id="errorMsg">Algo salió mal.</div>
              </div>
            </div>

            <!-- Botón de acción -->
            <button
              type="submit"
              id="btnSubmit"
              class="w-full bg-navy hover:bg-navy-light text-white font-bold py-4 rounded-xl text-sm uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2.5 shadow-lg shadow-navy/20 hover:shadow-navy/30 group disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-[-2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
              </svg>
              Publicar Propiedad Completa
            </button>
          </div>
        </section>

      </form>
    </main>

    <Footer lang="es" />
    <AccessibilityWidget lang="es" />

    <!-- ─── SCRIPT DEL CLIENTE ─────────────────────────── -->
    <script is:inline>
      let coverFile = null;
      let galleryFiles = [];

      // ── Utilidad de compresión WebP ──
      async function comprimirFoto(file, maxWidth = 1920, calidad = 0.82) {
        return new Promise((resolve) => {
          if (file.type === "image/webp" && file.size < 350 * 1024) {
            return resolve(file);
          }
          const reader = new FileReader();
          reader.readAsDataURL(file);
          reader.onload = (e) => {
            const img = new Image();
            img.src = e.target.result;
            img.onload = () => {
              const canvas = document.createElement("canvas");
              let width = img.width;
              let height = img.height;
              if (width > maxWidth) {
                height = Math.round((height * maxWidth) / width);
                width = maxWidth;
              }
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, width, height);
              canvas.toBlob(
                (blob) => {
                  const nombreLimpio = file.name.replace(/\.[^/.]+$/, "") + ".webp";
                  resolve(new File([blob], nombreLimpio, { type: "image/webp" }));
                },
                "image/webp",
                calidad
              );
            };
          };
        });
      }

      function initPublisher() {
        const form = document.getElementById("publishForm");
        const coverInput = document.getElementById("coverInput");
        const coverDropzone = document.getElementById("coverDropzone");
        const coverPlaceholder = document.getElementById("coverPlaceholder");
        const coverPreviewContainer = document.getElementById("coverPreviewContainer");
        const coverPreviewImg = document.getElementById("coverPreviewImg");
        const btnRemoveCover = document.getElementById("btnRemoveCover");

        const galleryInput = document.getElementById("galleryInput");
        const galleryDropzone = document.getElementById("galleryDropzone");
        const galleryPreviewsGrid = document.getElementById("galleryPreviewsGrid");
        const galleryCount = document.getElementById("galleryCount");

        const btnSubmit = document.getElementById("btnSubmit");
        const progressContainer = document.getElementById("progressContainer");
        const progressBar = document.getElementById("progressBar");
        const progressPercent = document.getElementById("progressPercent");
        const progressStatus = document.getElementById("progressStatus");
        const progressMsg = document.getElementById("progressMsg");

        const feedbackSuccess = document.getElementById("feedbackSuccess");
        const successDetail = document.getElementById("successDetail");
        const successLink = document.getElementById("successLink");
        const feedbackError = document.getElementById("feedbackError");
        const errorMsg = document.getElementById("errorMsg");

        if (!form || form.dataset.listenerAttached) return;
        form.dataset.listenerAttached = "true";

        // ── PORTADA ──
        coverDropzone.addEventListener("click", (e) => {
          if (e.target.id !== "btnRemoveCover" && !e.target.closest("#btnRemoveCover")) {
            coverInput.click();
          }
        });

        coverDropzone.addEventListener("dragover", (e) => {
          e.preventDefault();
          coverDropzone.classList.add("pub-dropzone-active");
        });
        coverDropzone.addEventListener("dragleave", () => {
          coverDropzone.classList.remove("pub-dropzone-active");
        });
        coverDropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          coverDropzone.classList.remove("pub-dropzone-active");
          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            setCoverFile(e.dataTransfer.files[0]);
          }
        });

        coverInput.addEventListener("change", () => {
          if (coverInput.files && coverInput.files[0]) {
            setCoverFile(coverInput.files[0]);
          }
        });

        function setCoverFile(file) {
          coverFile = file;
          coverPreviewImg.src = URL.createObjectURL(file);
          coverPlaceholder.classList.add("hidden");
          coverPlaceholder.style.display = "none";
          coverPreviewContainer.classList.remove("hidden");
          coverPreviewContainer.style.display = "";
        }

        btnRemoveCover.addEventListener("click", (e) => {
          e.stopPropagation();
          coverFile = null;
          coverInput.value = "";
          coverPreviewContainer.classList.add("hidden");
          coverPreviewContainer.style.display = "none";
          coverPlaceholder.classList.remove("hidden");
          coverPlaceholder.style.display = "";
        });

        // ── GALERÍA ──
        galleryDropzone.addEventListener("click", () => galleryInput.click());

        galleryDropzone.addEventListener("dragover", (e) => {
          e.preventDefault();
          galleryDropzone.classList.add("pub-dropzone-active");
        });
        galleryDropzone.addEventListener("dragleave", () => {
          galleryDropzone.classList.remove("pub-dropzone-active");
        });
        galleryDropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          galleryDropzone.classList.remove("pub-dropzone-active");
          if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            addGalleryFiles(Array.from(e.dataTransfer.files));
          }
        });

        galleryInput.addEventListener("change", () => {
          if (galleryInput.files) {
            addGalleryFiles(Array.from(galleryInput.files));
          }
        });

        function addGalleryFiles(newFiles) {
          galleryFiles = [...galleryFiles, ...newFiles.filter((f) => f.type.startsWith("image/"))];
          renderGalleryPreviews();
        }

        function renderGalleryPreviews() {
          galleryPreviewsGrid.innerHTML = "";
          galleryCount.textContent = galleryFiles.length + " foto(s)";

          galleryFiles.forEach((file, index) => {
            const card = document.createElement("div");
            card.className = "pub-gallery-card";
            card.innerHTML = `
              <img src="${URL.createObjectURL(file)}" class="w-full h-full object-cover" alt="Preview ${index + 1}" />
              <button type="button" class="pub-gallery-remove" data-index="${index}">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
              <span class="pub-gallery-index">${index + 1}</span>
            `;
            card.querySelector("button").addEventListener("click", (e) => {
              e.stopPropagation();
              galleryFiles.splice(index, 1);
              renderGalleryPreviews();
            });
            galleryPreviewsGrid.appendChild(card);
          });
        }

        // ── ENVÍO TRANSACCIONAL ──
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          if (!coverFile) {
            showError("Debes seleccionar la foto de portada antes de publicar.");
            return;
          }

          const adminPassword = document.getElementById("adminPassword").value;
          if (!adminPassword) {
            showError("Ingresa la contraseña de administrador.");
            return;
          }

          feedbackSuccess.classList.add("hidden");
          feedbackError.classList.add("hidden");
          btnSubmit.setAttribute("disabled", "true");
          btnSubmit.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Procesando...';
          progressContainer.classList.remove("hidden");

          const totalSteps = 1 + galleryFiles.length + 1;
          let currentStep = 0;

          function updateProgress(text, detail) {
            currentStep++;
            const pct = Math.round((currentStep / totalSteps) * 100);
            progressBar.style.width = pct + "%";
            progressPercent.textContent = pct + "%";
            progressStatus.textContent = text;
            if (detail) progressMsg.textContent = detail;
          }

          try {
            const formData = new FormData(form);
            const slug = formData.get("titulo")
              .toLowerCase()
              .normalize("NFD")
              .replace(/[\u0300-\u036f]/g, "")
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-+|-+$/g, "");

            // PASO 1: Subir portada a Vercel Blob
            updateProgress("Subiendo portada...", "Optimizando y subiendo la foto de portada a WebP...");
            const coverOptimized = await comprimirFoto(coverFile, 1920, 0.82);
            const coverUrl = await subirABlob(coverOptimized, slug, adminPassword);

            // PASO 2: Subir galería a Vercel Blob (secuencialmente)
            const galeriaUrls = [];
            for (let i = 0; i < galleryFiles.length; i++) {
              updateProgress(
                `Subiendo foto ${i + 1}/${galleryFiles.length}`,
                `Optimizando: ${galleryFiles[i].name}`
              );
              const optimized = await comprimirFoto(galleryFiles[i], 1920, 0.82);
              const url = await subirABlob(optimized, slug, adminPassword);
              galeriaUrls.push(url);
            }

            // PASO 3: Crear la propiedad en el backend
            updateProgress("Registrando propiedad...", "Creando el archivo JSON en el sistema...");

            const payload = {
              adminPassword,
              titulo: formData.get("titulo"),
              descripcion: formData.get("descripcion"),
              titulo_en: formData.get("titulo_en"),
              descripcion_en: formData.get("descripcion_en"),
              precioUsd: formData.get("precioUsd"),
              precioDop: formData.get("precioDop"),
              regimen: formData.get("regimen"),
              tipo: formData.get("tipo"),
              estado: formData.get("estado"),
              habitaciones: formData.get("habitaciones"),
              banos: formData.get("banos"),
              parqueos: formData.get("parqueos"),
              area: formData.get("area"),
              confotur: formData.get("confotur") === "on",
              exclusiva: formData.get("exclusiva") === "on",
              ubicacion: formData.get("ubicacion"),
              latitud: formData.get("latitud"),
              longitud: formData.get("longitud"),
              tipoVideo: formData.get("tipoVideo"),
              videoUrl: formData.get("videoUrl"),
              imagenPrincipal: coverUrl,
              galeria: galeriaUrls,
            };

            const res = await fetch("/api/propiedades/crear", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            const result = await res.json();
            if (!res.ok || !result.success) {
              throw new Error(result.error || "Error al crear la propiedad.");
            }

            // Éxito
            progressBar.style.width = "100%";
            progressPercent.textContent = "100%";
            progressStatus.textContent = "Completado";
            progressMsg.textContent = "¡Publicación exitosa!";

            successDetail.textContent = `Propiedad "${formData.get("titulo")}" creada con ${galeriaUrls.length} foto(s) de galería.`;
            successLink.href = `/propiedades/${result.slug}`;
            feedbackSuccess.classList.remove("hidden");
            feedbackSuccess.scrollIntoView({ behavior: "smooth", block: "nearest" });

            // Reset
            form.reset();
            coverFile = null;
            galleryFiles = [];
            coverPreviewContainer.classList.add("hidden");
            coverPreviewContainer.style.display = "none";
            coverPlaceholder.classList.remove("hidden");
            coverPlaceholder.style.display = "";
            galleryPreviewsGrid.innerHTML = "";
            galleryCount.textContent = "0 fotos";

          } catch (error) {
            showError(error.message);
          } finally {
            btnSubmit.removeAttribute("disabled");
            btnSubmit.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg> Publicar Propiedad Completa';
            setTimeout(() => {
              progressContainer.classList.add("hidden");
              progressBar.style.width = "0%";
              progressPercent.textContent = "0%";
            }, 5000);
          }
        });

        function showError(msg) {
          errorMsg.textContent = msg;
          feedbackError.classList.remove("hidden");
          feedbackError.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }

        // Reutiliza el endpoint existente de subir-galeria (modo blob)
        async function subirABlob(file, propertySlug, password) {
          const fd = new FormData();
          fd.append("mode", "blob");
          fd.append("propertySlug", propertySlug);
          fd.append("adminPassword", password);
          fd.append("foto", file);

          const res = await fetch("/api/subir-galeria", {
            method: "POST",
            body: fd,
          });
          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || "Error al subir imagen a Vercel Blob.");
          }
          return json.url;
        }
      }

      document.addEventListener("DOMContentLoaded", initPublisher);
      document.addEventListener("astro:page-load", initPublisher);
    </script>
  </body>
</html>

