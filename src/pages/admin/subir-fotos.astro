---
// src/pages/admin/subir-fotos.astro
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityWidget from "../../components/AccessibilityWidget.astro";
import { getCollection } from "astro:content";

export const prerender = false;

import type { ImageMetadata } from "astro";

// Resolver imágenes locales de assets
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP,JPG,PNG}",
  { eager: true },
);

// Obtener todas las propiedades ordenadas alfabéticamente por título
const propertiesCollection = await getCollection("propiedades");
const properties = propertiesCollection.map((entry) => {
  const imgRaw = String(entry.data.imagenPrincipal || "");
  let previewUrl = "";

  if (imgRaw.startsWith("http://") || imgRaw.startsWith("https://")) {
    previewUrl = imgRaw;
  } else if (imgRaw) {
    const rutaPublica = imgRaw.replace(/^\.\.\/\.\.\//, "/src/");
    const meta = imagenes[rutaPublica]?.default;
    if (meta) {
      previewUrl = meta.src;
    }
  }

  // Fallback a la galería solo si no hay imagen principal
  if (!previewUrl && Array.isArray(entry.data.galeria)) {
    for (const gItem of entry.data.galeria) {
      const gRaw = String(gItem || "");
      if (gRaw.startsWith("http://") || gRaw.startsWith("https://")) {
        previewUrl = gRaw;
        break;
      } else if (gRaw) {
        const rPub = gRaw.replace(/^\.\.\/\.\.\//, "/src/");
        const meta = imagenes[rPub]?.default;
        if (meta) {
          previewUrl = meta.src;
          break;
        }
      }
    }
  }

  return {
    id: entry.id,
    titulo: entry.data.titulo || entry.id.replace(/-/g, " "),
    previewUrl,
    tipo: entry.data.tipo || "",
    ubicacion: entry.data.ubicacion || "",
  };
}).sort((a, b) => a.titulo.localeCompare(b.titulo, "es", { sensitivity: "base" }));

// Mapa de ID → URL de preview para el JS del cliente
const previewMap: Record<string, string> = {};
properties.forEach((p) => {
  previewMap[p.id] = p.previewUrl;
});

// Datos completos para el combobox del cliente
const comboboxData = properties.map((p) => ({
  id: p.id,
  titulo: p.titulo,
  previewUrl: p.previewUrl,
  tipo: p.tipo,
  ubicacion: p.ubicacion,
}));
---

<!doctype html>
<html lang="es" class="bg-offwhite text-slate-900">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Carga Masiva de Fotos | Alexis RD Real Estate - Consola de Administración
    </title>
    <meta
      name="description"
      content="Suba múltiples fotos de propiedades a Vercel Blob y asócielas a los inmuebles."
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar lang="es" currentPage="admin-subir-fotos" />

    <!-- ─── HERO ADMINISTRATIVO ─────────────────────────── -->
    <section class="relative overflow-hidden pt-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"
