              class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5"
            >
              <svg
                class="w-3.5 h-3.5 text-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
