            id="feedback-error"
            class="hidden bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4 text-sm font-semibold flex items-center gap-3"
          >
            <svg
              class="w-5 h-5 text-red-500 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div id="error-msg">
              Algo salió mal durante la subida de las fotos.
            </div>
          </div>
        </form>
      </div>
    </main>

    <Footer lang="es" />
    <AccessibilityWidget lang="es" />

    <script
      type="application/json"
      id="preview-map-data"
      set:html={JSON.stringify(previewMap)}
    />
    <script
      type="application/json"
      id="combobox-data"
      set:html={JSON.stringify(comboboxData)}
    />

    <script is:inline>
      const PREVIEW_MAP = JSON.parse(
        document.getElementById("preview-map-data").textContent || "{}",
      );
      const COMBOBOX_ITEMS = JSON.parse(
        document.getElementById("combobox-data").textContent || "[]",
      );

      // ── Utilidad de compresión WebP en el navegador ──
      async function comprimirFoto(file, maxWidth = 1920, calidad = 0.8) {
        return new Promise((resolve) => {
          // Si ya es un archivo WebP ligero, no re-procesar
          if (file.type === "image/webp" && file.size < 800 * 1024) {
            return resolve(file);
          }

          const reader = new FileReader();
          reader.readAsDataURL(file);
          reader.onload = (e) => {
            const img = new Image();
            img.src = e.target.result;
            img.onload = () => {
              const canvas = document.createElement("canvas");
              let width = img.width;
              let height = img.height;

              if (width > maxWidth) {
                height = Math.round((height * maxWidth) / width);
                width = maxWidth;
              }

              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, width, height);

              canvas.toBlob(
                (blob) => {
                  const nombreLimpio =
                    file.name.replace(/\.[^/.]+$/, "") + ".webp";
                  resolve(
                    new File([blob], nombreLimpio, { type: "image/webp" }),
                  );
                },
                "image/webp",
                calidad,
              );
            };
          };
        });
      }

      function initUploadFotos() {
        const form = document.getElementById("upload-form");
        const dropzone = document.getElementById("dropzone");
        const fileInput = document.getElementById("fotos");
        const fileListContainer = document.getElementById(
          "file-list-container",
        );
        const fileList = document.getElementById("file-list");
        const fileCount = document.getElementById("file-count");
        const btnSubmit = document.getElementById("btn-submit");

        const progressContainer = document.getElementById("progress-container");
        const progressBar = document.getElementById("progress-bar");
        const progressPercent = document.getElementById("progress-percent");
        const progressMsg = document.getElementById("progress-msg");

        const successFeedback = document.getElementById("feedback-success");
        const successDesc = document.getElementById("success-desc");
        const errorFeedback = document.getElementById("feedback-error");
        const errorMsg = document.getElementById("error-msg");

        const propertyPreview = document.getElementById("property-preview");
        const propertyPreviewNoImg = document.getElementById(
          "property-preview-no-img",
        );
        const previewImg = document.getElementById("preview-img");
        const previewTitle = document.getElementById("preview-title");
        const previewTitleNoImg = document.getElementById(
          "preview-title-no-img",
        );
        const hiddenSlug = document.getElementById("propertySlug");

        if (!form || form.dataset.listenerAttached) return;
        form.dataset.listenerAttached = "true";

        // ── COMBOBOX INTERACTIVO ──────────────────────────
        const comboSearch = document.getElementById("combobox-search");
        const comboDropdown = document.getElementById("combobox-dropdown");
        const comboList = document.getElementById("combobox-list");
        const comboEmpty = document.getElementById("combobox-empty");
        const comboChevron = document.getElementById("combobox-chevron");
        const comboCount = document.getElementById("combobox-count");
        const comboTrigger = document.getElementById("combobox-trigger");

        let isOpen = false;
        let selectedId = "";
        let highlightIndex = -1;

        function normalize(str) {
          return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
        }

        function renderOptions(query = "") {
          const q = normalize(query);
          const filtered = q
            ? COMBOBOX_ITEMS.filter(
                (item) =>
                  normalize(item.titulo).includes(q) ||
                  normalize(item.id).includes(q) ||
                  normalize(item.ubicacion).includes(q) ||
                  normalize(item.tipo).includes(q)
              )
            : COMBOBOX_ITEMS;

          comboList.innerHTML = "";
          highlightIndex = -1;

          if (filtered.length === 0) {
            comboEmpty.classList.remove("hidden");
            comboCount.textContent = "";
          } else {
            comboEmpty.classList.add("hidden");
            comboCount.textContent = `${filtered.length}/${COMBOBOX_ITEMS.length}`;

            filtered.forEach((item, i) => {
              const li = document.createElement("li");
              li.className = "combobox-option";
              li.dataset.id = item.id;
              li.dataset.titulo = item.titulo;
              li.dataset.index = i;

              if (item.id === selectedId) {
                li.classList.add("combobox-option-selected");
              }

              const thumb = item.previewUrl
                ? `<img src="${item.previewUrl}" alt="" class="combobox-thumb" loading="lazy" />`
                : `<div class="combobox-thumb-placeholder">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>`;

              const badge = item.tipo
                ? `<span class="combobox-badge">${item.tipo}</span>`
                : "";

              li.innerHTML = `
                <div class="combobox-option-inner">
                  ${thumb}
                  <div class="combobox-option-text">
                    <span class="combobox-option-title">${item.titulo}</span>
                    <span class="combobox-option-id">${item.id}${item.ubicacion ? ' · ' + item.ubicacion : ''}</span>
                  </div>
                  ${badge}
                  ${item.id === selectedId ? '<svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' : ''}
                </div>
              `;

              li.addEventListener("click", () => selectItem(item));
              li.addEventListener("mouseenter", () => {
                highlightIndex = parseInt(li.dataset.index);
                updateHighlight();
              });

              comboList.appendChild(li);
            });
          }
        }

        function updateHighlight() {
          comboList.querySelectorAll(".combobox-option").forEach((el, i) => {
            el.classList.toggle("combobox-option-highlighted", i === highlightIndex);
          });
        }

        function selectItem(item) {
          selectedId = item.id;
          hiddenSlug.value = item.id;
          comboSearch.value = item.titulo;
          closeDropdown();

          // Actualizar la tarjeta de previsualización
          const imgUrl = PREVIEW_MAP[item.id] || "";
          if (imgUrl) {
            previewImg.src = imgUrl;
            previewImg.onerror = function () {
              propertyPreview.classList.add("hidden");
              previewTitleNoImg.textContent = item.titulo;
              propertyPreviewNoImg.classList.remove("hidden");
            };
            previewTitle.textContent = item.titulo;
            propertyPreview.classList.remove("hidden");
            propertyPreviewNoImg.classList.add("hidden");
          } else {
            propertyPreview.classList.add("hidden");
            previewTitleNoImg.textContent = item.titulo;
            propertyPreviewNoImg.classList.remove("hidden");
          }
        }

        function openDropdown() {
          isOpen = true;
          comboDropdown.classList.remove("hidden");
          comboChevron.style.transform = "rotate(180deg)";
          comboTrigger.classList.add("combobox-trigger-active");
          renderOptions(comboSearch.value);
        }

        function closeDropdown() {
          isOpen = false;
          comboDropdown.classList.add("hidden");
          comboChevron.style.transform = "";
          comboTrigger.classList.remove("combobox-trigger-active");
          // Si no se seleccionó nada y había texto, restaurar el título seleccionado
          if (!selectedId && comboSearch.value) {
            comboSearch.value = "";
          } else if (selectedId) {
            const sel = COMBOBOX_ITEMS.find((i) => i.id === selectedId);
            if (sel) comboSearch.value = sel.titulo;
          }
        }

        comboTrigger.addEventListener("click", (e) => {
          if (e.target === comboSearch) return; // let focus handle it
          comboSearch.focus();
        });

        comboSearch.addEventListener("focus", () => {
          if (!isOpen) openDropdown();
          comboSearch.select();
        });

        comboSearch.addEventListener("input", () => {
          if (!isOpen) openDropdown();
          renderOptions(comboSearch.value);
        });

        comboSearch.addEventListener("keydown", (e) => {
          const options = comboList.querySelectorAll(".combobox-option");
          if (e.key === "ArrowDown") {
            e.preventDefault();
            if (!isOpen) openDropdown();
            highlightIndex = Math.min(highlightIndex + 1, options.length - 1);
            updateHighlight();
            options[highlightIndex]?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            highlightIndex = Math.max(highlightIndex - 1, 0);
            updateHighlight();
            options[highlightIndex]?.scrollIntoView({ block: "nearest" });
          } else if (e.key === "Enter") {
            e.preventDefault();
            if (highlightIndex >= 0 && options[highlightIndex]) {
              const id = options[highlightIndex].dataset.id;
              const item = COMBOBOX_ITEMS.find((i) => i.id === id);
              if (item) selectItem(item);
            }
          } else if (e.key === "Escape") {
            closeDropdown();
            comboSearch.blur();
          }
        });

        // Cerrar al hacer click fuera
        document.addEventListener("click", (e) => {
          if (isOpen && !document.getElementById("combobox-wrapper").contains(e.target)) {
            closeDropdown();
          }
        });

        // ── FIN COMBOBOX ──────────────────────────

        dropzone.addEventListener("click", () => fileInput.click());

        dropzone.addEventListener("dragover", (e) => {
          e.preventDefault();
          dropzone.classList.add("border-gold", "bg-[#f8fafc]");
        });

        dropzone.addEventListener("dragleave", () => {
          dropzone.classList.remove("border-gold", "bg-[#f8fafc]");
        });

        dropzone.addEventListener("drop", (e) => {
          e.preventDefault();
          dropzone.classList.remove("border-gold", "bg-[#f8fafc]");
          if (e.dataTransfer.files.length > 0) {
            fileInput.files = e.dataTransfer.files;
            updateFileList();
          }
        });

        fileInput.addEventListener("change", updateFileList);

        function updateFileList() {
          fileList.innerHTML = "";
          const files = fileInput.files;
          if (files.length > 0) {
            fileListContainer.classList.remove("hidden");
            fileCount.textContent = files.length;
            Array.from(files).forEach((file) => {
              const li = document.createElement("li");
              li.className =
                "flex justify-between items-center border-b border-slate-100 pb-1 file-list-item";
              li.innerHTML = `
            <span class="truncate max-w-[80%]">${file.name}</span>
            <span class="text-slate-400 font-mono">${(file.size / (1024 * 1024)).toFixed(2)} MB</span>
          `;
              fileList.appendChild(li);
            });
          } else {
            fileListContainer.classList.add("hidden");
          }
        }

        // Procesamiento con compresión en el cliente
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          const propertySlug = hiddenSlug.value;
          const adminPassword = document.getElementById("adminPassword").value;
          const rawFiles = Array.from(fileInput.files);

          if (!propertySlug || rawFiles.length === 0 || !adminPassword) return;

          successFeedback.classList.add("hidden");
          errorFeedback.classList.add("hidden");

          btnSubmit.setAttribute("disabled", "true");
          progressContainer.classList.remove("hidden");

          progressBar.style.width = "5%";
          progressPercent.textContent = "5%";
          progressMsg.textContent = `Optimizando ${rawFiles.length} foto(s)...`;

          const uploadedUrls = [];
          const failedFiles = [];

          try {
            // ── PASO 1: Comprimir y subir individualmente a Vercel Blob ──
            for (let i = 0; i < rawFiles.length; i++) {
              const originalFile = rawFiles[i];
              const current = i + 1;

              progressMsg.textContent = `Optimizando y subiendo (${current}/${rawFiles.length}): ${originalFile.name}`;

              // Compresión en el navegador
              const optimizedFile = await comprimirFoto(
                originalFile,
                1920,
                0.8,
              );

              const fd = new FormData();
              fd.append("mode", "blob");
              fd.append("propertySlug", propertySlug);
              fd.append("adminPassword", adminPassword);
              fd.append("foto", optimizedFile);

              try {
                const res = await fetch("/api/subir-galeria", {
                  method: "POST",
                  body: fd,
                });
                const json = await res.json();

                if (res.ok && json.success) {
                  uploadedUrls.push(json.url);
                } else {
                  failedFiles.push(
                    `${originalFile.name}: ${json.error || "error en Blob"}`,
                  );
                }
              } catch (fetchErr) {
                failedFiles.push(`${originalFile.name}: ${fetchErr.message}`);
              }

              const pct = Math.round(5 + (80 * current) / rawFiles.length);
              progressBar.style.width = `${pct}%`;
              progressPercent.textContent = `${pct}%`;
            }

            if (uploadedUrls.length === 0) {
              throw new Error(
                "No se pudo subir ninguna foto. " + failedFiles.join("; "),
              );
            }

            // ── PASO 2: Commit único en GitHub con las URLs ──
            progressBar.style.width = "90%";
            progressPercent.textContent = "90%";
            progressMsg.textContent =
              "Guardando URLs en el archivo JSON de GitHub...";

            const commitFd = new FormData();
            commitFd.append("mode", "commit");
            commitFd.append("propertySlug", propertySlug);
            commitFd.append("adminPassword", adminPassword);
            commitFd.append("urls", JSON.stringify(uploadedUrls));

            const commitRes = await fetch("/api/subir-galeria", {
              method: "POST",
              body: commitFd,
            });
            const commitResult = await commitRes.json();

            if (!commitRes.ok || !commitResult.success) {
              throw new Error(
                commitResult.error || "Error al guardar las URLs en GitHub.",
              );
            }

            // ── Éxito Final ──
            progressBar.style.width = "100%";
            progressPercent.textContent = "100%";
            progressMsg.textContent = "¡Carga completada!";

            let successText = `Se subieron y optimizaron con éxito ${uploadedUrls.length} foto(s).`;
            if (failedFiles.length > 0) {
              successText += ` (${failedFiles.length} fallaron: ${failedFiles.join(", ")})`;
            }
            successDesc.textContent = successText;
            successFeedback.classList.remove("hidden");
            successFeedback.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });

            form.reset();
            comboSearch.value = "";
            selectedId = "";
            hiddenSlug.value = "";
            propertyPreview.classList.add("hidden");
            propertyPreviewNoImg.classList.add("hidden");
            fileListContainer.classList.add("hidden");
            fileList.innerHTML = "";
          } catch (error) {
            errorMsg.textContent = error.message;
            errorFeedback.classList.remove("hidden");
            errorFeedback.scrollIntoView({
              behavior: "smooth",
              block: "nearest",
            });
          } finally {
            btnSubmit.removeAttribute("disabled");
            setTimeout(() => {
              progressContainer.classList.add("hidden");
              progressBar.style.width = "0%";
              progressPercent.textContent = "0%";
            }, 4000);
          }
        });
      }

      document.addEventListener("DOMContentLoaded", initUploadFotos);
      document.addEventListener("astro:page-load", initUploadFotos);
    </script>
  </body>
</html>

