---
// src/pages/contacto.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';

const WHATSAPP_PHONE = "18295259993";
const FORMSPREE_ID = "xjkvqbgp"; // Reemplaza con tu ID real de Formspree

const contactChannels = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
    label: 'Teléfono',
    value: '+1 (829) 525-9993',
    href: 'tel:+18295259993',
    subtitle: 'Lunes – Sábado, 9am – 7pm',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
    label: 'Correo Electrónico',
    value: 'alexis@alexisrd.com',
    href: 'mailto:alexis@alexisrd.com',
    subtitle: 'Respuesta en menos de 24h',
  },
  {
    icon: `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>`,
    label: 'WhatsApp',
    value: 'Chatear ahora con Alexis',
    href: `https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent('Hola Alexis, me gustaría obtener más información sobre sus servicios inmobiliarios.')}`,
    subtitle: 'Respuesta rápida · Inmediato',
    isFilled: true,
    isWhatsApp: true,
  },
];
---

<!DOCTYPE html>
<html lang="es" class="bg-offwhite text-slate-900">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contacto | Alexis RD Real Estate – Asesoría Inmobiliaria en República Dominicana</title>
  <meta name="description" content="Contáctanos para asesoría inmobiliaria personalizada en República Dominicana. Llámanos, escríbenos por WhatsApp o envía un mensaje. Alexis RD Real Estate." />
</head>
<body class="min-h-screen flex flex-col">

  <Navbar lang="es" currentPage="contact" />

  <!-- ─── HERO COMPACTO ─────────────────────────── -->
  <section class="relative overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"></div>
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Glow accent -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-gold/8 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-22 text-center">
      <span class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        Estamos aquí para ayudarte
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight tracking-tight">
        Habla con un
        <span class="text-gold"> experto inmobiliario</span>
      </h1>
      <p class="mt-4 text-white/80 max-w-xl mx-auto text-base leading-relaxed">
        ¿Buscas tu próximo hogar, tienes una propiedad que vender, o simplemente necesitas orientación? Estamos a un mensaje de distancia.
      </p>
    </div>
  </section>

  <!-- ─── MAIN CONTENT: TWO COLUMNS ───────────────── -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 flex-1 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-start">

      <!-- ── LEFT COLUMN: Direct channels (2/5) ── -->
      <div class="lg:col-span-2 space-y-5">
        <div class="mb-8">
          <h2 class="text-2xl font-extrabold text-navy">Canales directos</h2>
          <p class="text-warm-gray text-sm mt-2 leading-relaxed">Para consultas rápidas, utiliza cualquiera de estos canales y te atenderemos a la brevedad.</p>
        </div>

        {contactChannels.map(ch => (
          <a
            href={ch.href}
            target={ch.href.startsWith('http') ? '_blank' : undefined}
            rel={ch.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class={`group flex items-start gap-4 p-5 rounded-2xl border transition-all duration-300 hover:-translate-y-0.5 ${
              ch.isWhatsApp
                ? 'bg-emerald-600 border-emerald-500 hover:bg-emerald-500 shadow-lg shadow-emerald-600/20 hover:shadow-emerald-500/30'
                : 'bg-white border-slate-200 hover:border-gold/40 hover:shadow-[0_4px_20px_-4px_rgba(0,0,0,0.08)]'
            }`}
          >
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center shrink-0 transition-colors duration-300 ${
              ch.isWhatsApp
                ? 'bg-white/20'
                : 'bg-navy/5 group-hover:bg-gold/10'
            }`}>
              <svg
                class={`w-5 h-5 ${ch.isWhatsApp ? 'text-white' : 'text-navy group-hover:text-gold transition-colors duration-300'}`}
                fill={ch.isFilled ? 'currentColor' : 'none'}
                stroke={ch.isFilled ? 'none' : 'currentColor'}
                viewBox="0 0 24 24"
                set:html={ch.icon}
              ></svg>
            </div>
            <div class="min-w-0">
              <p class={`text-xs font-bold uppercase tracking-wider mb-0.5 ${ch.isWhatsApp ? 'text-white/70' : 'text-gold'}`}>
                {ch.label}
              </p>
              <p class={`text-sm font-bold leading-snug ${ch.isWhatsApp ? 'text-white' : 'text-navy'}`}>
                {ch.value}
              </p>
              <p class={`text-xs mt-0.5 ${ch.isWhatsApp ? 'text-white/75' : 'text-warm-gray'}`}>
                {ch.subtitle}
              </p>
            </div>
            <svg
              class={`w-4 h-4 ml-auto mt-0.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 ${ch.isWhatsApp ? 'text-white/70' : 'text-slate-300 group-hover:text-gold'}`}
              fill="none" stroke="currentColor" viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}

        <!-- Trust badge -->
        <div class="mt-8 p-5 bg-navy rounded-2xl border border-white/5">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 bg-gold/20 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <p class="text-white font-bold text-sm">Confianza garantizada</p>
          </div>
          <p class="text-white/75 text-xs leading-relaxed">Más de 12 años trabajando con clientes locales e internacionales en República Dominicana. Tu privacidad y satisfacción son nuestra prioridad.</p>
        </div>
      </div>

      <!-- ── RIGHT COLUMN: Contact Form (3/5) ── -->
      <div class="lg:col-span-3">
        <div class="bg-white rounded-3xl shadow-[0_4px_40px_-8px_rgba(11,25,44,0.12)] border border-slate-100 overflow-hidden">

          <!-- Form header -->
          <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-6 flex items-center gap-4">
            <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-bold text-base">Envíanos un Mensaje</p>
              <p class="text-white/45 text-xs">Alianzas, consultas generales o dudas del mercado</p>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
              <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
              <span class="text-emerald-400 text-xs font-semibold">En línea</span>
            </div>
          </div>

          <!-- Formspree Form -->
          <form
            id="contacto-form"
            action={`https://formspree.io/f/${FORMSPREE_ID}`}
            method="POST"
            class="p-8 md:p-10 space-y-5"
          >
            <input type="hidden" name="Formulario" value="Contacto General" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Nombre -->
              <div class="flex flex-col gap-1.5">
                <label for="nombre" class="text-xs font-bold text-navy uppercase tracking-wider">
                  Nombre Completo <span class="text-gold">*</span>
                </label>
                <input
                  type="text" id="nombre" name="Nombre" required
                  placeholder="Tu nombre"
                  class="contact-input"
                />
              </div>

              <!-- Correo -->
              <div class="flex flex-col gap-1.5">
                <label for="correo" class="text-xs font-bold text-navy uppercase tracking-wider">
                  Correo Electrónico <span class="text-gold">*</span>
                </label>
                <input
                  type="email" id="correo" name="Correo" required
                  placeholder="tu@email.com"
                  class="contact-input"
                />
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex flex-col gap-1.5">
              <label for="telefono" class="text-xs font-bold text-navy uppercase tracking-wider">
                Teléfono / WhatsApp
              </label>
              <input
                type="tel" id="telefono" name="Teléfono"
                placeholder="+1 (809) 000-0000"
                class="contact-input"
              />
            </div>

            <!-- Asunto -->
            <div class="flex flex-col gap-1.5">
              <label for="asunto" class="text-xs font-bold text-navy uppercase tracking-wider">
                Asunto <span class="text-gold">*</span>
              </label>
              <select id="asunto" name="Asunto" required class="contact-input">
                <option value="" disabled selected>Selecciona un tema...</option>
                <option value="Consulta de Compra">Consulta de Compra</option>
                <option value="Consulta de Alquiler">Consulta de Alquiler</option>
                <option value="Alianza Comercial">Alianza Comercial</option>
                <option value="Inversión Internacional">Inversión Internacional</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <!-- Mensaje -->
            <div class="flex flex-col gap-1.5">
              <label for="mensaje" class="text-xs font-bold text-navy uppercase tracking-wider">
                Mensaje <span class="text-gold">*</span>
              </label>
              <textarea
                id="mensaje" name="Mensaje" required rows={5}
                placeholder="Cuéntanos en qué podemos ayudarte. Cuantos más detalles nos das, mejor podemos orientarte..."
                class="contact-input resize-none"
              ></textarea>
            </div>

            <!-- Privacy -->
            <p class="text-xs text-slate-400 flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-gold/50 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Tu información es estrictamente confidencial. No compartimos datos con terceros.
            </p>

            <!-- Submit -->
            <button
              type="submit"
              id="btn-contacto"
              class="w-full bg-navy hover:bg-navy-light text-white font-bold py-4 rounded-xl text-sm uppercase tracking-widest transition-all duration-200 flex items-center justify-center gap-2.5 shadow-lg shadow-navy/20 hover:shadow-navy/30 group"
            >
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              Enviar Mensaje
            </button>

            <!-- Feedback msgs -->
            <div id="contact-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-5 py-4 text-sm font-semibold flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              ¡Mensaje enviado! Te responderemos pronto.
            </div>
            <div id="contact-error" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4 text-sm font-semibold flex items-center gap-3">
              <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Algo salió mal. Por favor escríbenos por WhatsApp.
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer lang="es" />
  <AccessibilityWidget lang="es" />

  <script>
    const form = document.getElementById('contacto-form') as HTMLFormElement | null;
    const btn = document.getElementById('btn-contacto');
    const successEl = document.getElementById('contact-success');
    const errorEl = document.getElementById('contact-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;
      btn?.setAttribute('disabled', 'true');
      if (btn) btn.textContent = 'Enviando...';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          successEl?.classList.remove('hidden');
          errorEl?.classList.add('hidden');
          successEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else throw new Error();
      } catch {
        errorEl?.classList.remove('hidden');
        successEl?.classList.add('hidden');
      } finally {
        btn?.removeAttribute('disabled');
        if (btn) btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg> Enviar Mensaje`;
      }
    });
  </script>

</body>
</html>

<style>
  .contact-input {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #0B192C;
    width: 100%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .contact-input::placeholder {
    color: #94a3b8;
  }
  .contact-input:focus {
    outline: none;
    border-color: #C9A84C;
    box-shadow: 0 0 0 3px rgba(201,168,76,0.15);
  }
</style>
