---
// src/pages/en/about-us.astro
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AccessibilityWidget from '../../components/AccessibilityWidget.astro';

const WHATSAPP_PHONE = "18295259993";

const stats = [
  { value: '150+', label: 'Properties Sold' },
  { value: '98%', label: 'Client Satisfaction' },
  { value: '12+', label: 'Years of Experience' },
  { value: '$50M+', label: 'In Transactions' },
];

const objectives = [
  "Offer high-level real estate advice based on honesty, transparency, and trust.",
  "Identify properties with high potential for appreciation and profitability for our clients and investors.",
  "Negotiate the best conditions and prices in every real estate transaction.",
  "Build long-lasting relationships with clients, investors, and strategic allies, based on respect and commitment.",
  "Maintain a continuous improvement process, incorporating innovation, technology, and market strategies to offer service excellence.",
  "Contribute to the development of the real estate sector in the Dominican Republic through responsible and professional practices.",
  "Exceed our clients' expectations, becoming their trusted ally for every real estate decision."
];
---

<!DOCTYPE html>
<html lang="en" class="bg-offwhite text-slate-900">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | Alexis RD Real Estate – Vision, Mission, and Objectives</title>
  <meta name="description" content="Learn about the corporate Vision, Mission, and Objectives of Alexis RD Real Estate. Your trusted real estate partner in the Dominican Republic for secure investments." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col font-sans">

  <Navbar lang="en" currentPage="nosotros" />

  <!-- ─── HERO ─────────────────────────── -->
  <section class="relative overflow-hidden pt-28 pb-16">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"></div>
    <!-- Grid overlay -->
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <!-- Glow -->
    <div class="absolute bottom-0 left-1/4 w-96 h-64 bg-gold/6 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-5">
          Who we are
        </span>
        <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight tracking-tight font-display">
          Our Values & <br />
          <span class="text-gold">Commitment</span>
        </h1>
        <p class="mt-4 text-white/80 text-base leading-relaxed">
          Alexis RD Real Estate is founded on integrity, specialized knowledge, and the goal of ensuring that every real estate investment in the Dominican Republic is successful and profitable.
        </p>
      </div>

      <!-- Quick statistics -->
      <div class="grid grid-cols-2 gap-4 max-w-sm w-full">
        {stats.map(s => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center backdrop-blur-sm">
            <div class="text-2xl font-black text-gold">{s.value}</div>
            <div class="text-[10px] text-white/70 font-bold uppercase tracking-wider mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── VISIÓN Y MISIÓN ─────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Mission -->
      <div class="bg-white border border-slate-200/80 rounded-3xl p-8 md:p-10 shadow-sm relative group hover:border-[#C9A84C]/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-gold/10 flex items-center justify-center text-gold mb-6 border border-gold/25 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-navy tracking-tight font-display mb-4">Mission</h2>
          <p class="text-slate-600 leading-relaxed text-sm">
            To provide a comprehensive, transparent, and personalized real estate service, accompanying each client throughout the buying, selling, and investment process. Our commitment is to identify the best market opportunities, negotiate the most favorable conditions, and guarantee secure transactions, backed by ethics, professionalism, and a deep knowledge of the real estate sector.
          </p>
        </div>
      </div>

      <!-- Vision -->
      <div class="bg-white border border-slate-200/80 rounded-3xl p-8 md:p-10 shadow-sm relative group hover:border-[#C9A84C]/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-gold/10 flex items-center justify-center text-gold mb-6 border border-gold/25 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-navy tracking-tight font-display mb-4">Vision</h2>
          <p class="text-slate-600 leading-relaxed text-sm">
            To be the leading real estate agency in the Dominican Republic, recognized for our integrity, excellence, and commitment to our clients' success. We aspire to transform the experience of investing and acquiring real estate, building long-term trust relationships and providing opportunities that generate growth, security, and profitability.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── OBJETIVOS ─────────────────────────── -->
  <section class="bg-navy py-20 w-full relative overflow-hidden">
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(201,168,76,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.03) 1px, transparent 1px); background-size: 60px 60px;"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-gold text-xs font-bold uppercase tracking-[0.25em]">Way to Success</span>
        <h2 class="text-3xl font-extrabold text-white mt-2 font-display">Our Objectives</h2>
        <p class="mt-3 text-white/50 max-w-xl mx-auto text-sm">
          We establish clear goals based on sustainable growth and maximum benefit for our clients.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {objectives.map((obj, index) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 flex items-start gap-4 hover:border-gold/30 hover:bg-white/8 transition-all duration-300">
            <span class="w-8 h-8 rounded-xl bg-gold/10 flex items-center justify-center text-gold font-bold text-sm shrink-0 border border-gold/20">
              {index + 1}
            </span>
            <p class="text-white/85 text-[13.5px] leading-relaxed mt-0.5">
              {obj}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA ─────────────────────────── -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h2 class="text-3xl font-extrabold text-navy font-display">Ready to take the next step?</h2>
    <p class="mt-3 text-slate-500 max-w-lg mx-auto text-sm leading-relaxed">
      Let us guide you with professionalism and honesty in your next real estate investment in the Dominican Republic.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/en/contact"
        class="w-full sm:w-auto bg-[#0B192C] border border-[#C9A84C]/20 hover:bg-[#C9A84C] hover:text-[#0B192C] hover:shadow-lg hover:shadow-[#C9A84C]/25 hover:-translate-y-0.5 active:scale-[0.98] text-white font-bold px-8 py-3.5 rounded-xl text-xs transition-all duration-300 ease-in-out uppercase tracking-widest shadow-md text-center"
      >
        Email Us
      </a>
      <a
        href={`https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent('Hello Alexis, I would like to receive advice to buy a property.')}`}
        target="_blank" rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 hover:-translate-y-0.5 active:scale-[0.98] text-white font-bold px-8 py-3.5 rounded-xl text-xs transition-all duration-300 ease-in-out uppercase tracking-widest shadow-md"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp Advice
      </a>
    </div>
  </section>

  <Footer lang="en" />
  <AccessibilityWidget lang="en" />

</body>
</html>
