---
// src/pages/en/index.astro
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Buscador from '../../components/buscador.astro'; 
import AccessibilityWidget from '../../components/AccessibilityWidget.astro';
import { Image } from 'astro:assets'; 
import { useTranslations } from '../../utils/i18n';
import * as deepl from 'deepl-node';

import logoEmpresa from '../../assets/images/logo-alexis-rd.jpg';
import fallbackImage from '../../assets/images/prueba-inmobiliaria.jpg';

const t = useTranslations('en');
const modulosJSON = import.meta.glob('/src/content/propiedades/**/*.json', { eager: true });
const imagenes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP}', { eager: true });

const translateTipo: Record<string, string> = {
  'apartamento': 'Apartment', 'villa': 'Villa', 'casa': 'House',
  'solar': 'Lot / Land', 'terreno': 'Land'
};

const translateEstado: Record<string, string> = {
  'en planos': 'Under Construction', 'en construcción': 'Under Construction',
  'listo para entrega': 'Ready for Delivery', 'disponible': 'Available'
};

// 🔑 Configuración del traductor seguro
const DEEPL_AUTH_KEY = "cfcc4e7f-2356-4f78-a8e3-3bc2bc6aafb4:fx";
let translator: any = null;
try {
  if (DEEPL_AUTH_KEY) {
    translator = new deepl.Translator(DEEPL_AUTH_KEY);
  }
} catch (e) {
  console.error("Error al inicializar DeepL en index.astro:", e);
}

const propiedadesBase = Object.entries(modulosJSON).map(([ruta, modulo]) => {
  const contenido = modulo as any;
  const id = ruta.split('/').pop()?.replace('.json', '') || 'property';
  
  const rawPrecioString = String(contenido.precio || '0');
  const cleanPrecioString = rawPrecioString.replace(/[^0-9]/g, '');
  const validatedPrecioNum = parseInt(cleanPrecioString, 10) || 0;
  
  const tipoOriginal = String(contenido.tipo || 'apartamento').toLowerCase().trim();
  const estadoOriginal = String(contenido.estado || 'en planos').toLowerCase().trim();

  const rutaRaw = String(contenido.imagenPrincipal || '');
  const imagenPublica = rutaRaw ? rutaRaw.replace(/^\.\.\/\.\.\//, '/src/') : '';
  const imgMeta = imagenes[imagenPublica]?.default || fallbackImage;

  return {
    id: id,
    precio: validatedPrecioNum,
    ubicacion: contenido.ubicacion || 'Dominican Republic',
    tipo: translateTipo[tipoOriginal] || contenido.tipo || 'Apartment',
    estado: translateEstado[estadoOriginal] || contenido.estado || 'Under Construction',
    confotur: Boolean(contenido.confotur),
    habitaciones: Number(contenido.habitaciones) || 0,
    banos: Number(contenido.banos) || 0,
    parqueos: Number(contenido.parqueos) || 0,
    area: Number(contenido.area) || 0,
    imagenPrincipal: contenido.imagenPrincipal || '',
    imagenMetadata: imgMeta,
    // Textos originales
    tituloOriginal: contenido.titulo || id.replace(/-/g, ' '),
    descripcionOriginal: contenido.descripcion || 'Discover this amazing real estate opportunity.',
    // Textos manuales desde Keystatic
    tituloEnCMS: contenido.titulo_en || '',
    descripcionEnCMS: contenido.descripcion_en || '',
  };
});

// 2. 🚀 PROCESAMIENTO POR LOTE EN EL SERVIDOR CON DEEPL (Traductor Invisible)
const allPropiedades = await Promise.all(
  propiedadesBase.map(async (p) => {
    let finalTitulo = p.tituloEnCMS;
    let finalDesc = p.descripcionEnCMS;

    if (translator) {
      try {
        if (!finalTitulo) {
          const res = await translator.translateText(p.tituloOriginal, null, 'en-US');
          finalTitulo = res.text;
        }
        if (!finalDesc) {
          const res = await translator.translateText(p.descripcionOriginal, null, 'en-US');
          finalDesc = res.text;
        }
      } catch (err) {
        console.warn(`Error traduciendo propiedad ${p.id} en Home:`, err);
      }
    }

    if (!finalTitulo) finalTitulo = p.tituloOriginal;
    if (!finalDesc) finalDesc = p.descripcionOriginal;

    return {
      id: p.id,
      data: {
        titulo: finalTitulo,
        descripcion: finalDesc,
        precio: p.precio,
        ubicacion: p.ubicacion,
        tipo: p.tipo,
        estado: p.estado,
        confotur: p.confotur,
        habitaciones: p.habitaciones,
        banos: p.banos,
        parqueos: p.parqueos,
        area: p.area,
        imagenPrincipal: p.imagenPrincipal,
        imagenMetadata: p.imagenMetadata,
      }
    };
  })
);

const WHATSAPP_PHONE = "18295259993";

const featuredProps = allPropiedades.slice(0, 3).map(p => {
  const cleanUbicacion = p.data.ubicacion ? String(p.data.ubicacion).replace(/\b\w/g, char => char.toUpperCase()) : 'Dominican Republic';
  return {
    id: p.id,
    titulo: p.data.titulo,
    ubicacion: cleanUbicacion,
    precio: p.data.precio,
    tipo: p.data.tipo,
    imagenPrincipal: p.data.imagenPrincipal,
    imagenMetadata: p.data.imagenMetadata,
    estado: p.data.estado
  };
});

const stats = [
  { value: '150+', label: 'Properties Sold' },
  { value: '12+',  label: 'Years of Experience' },
  { value: '98%',  label: 'Satisfied Clients' },
  { value: '$50M+',label: 'In Transactions' },
];
