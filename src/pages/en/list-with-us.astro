---
// src/pages/en/list-with-us.astro
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AccessibilityWidget from '../../components/AccessibilityWidget.astro';

const WHATSAPP_PHONE = "18295259993";
const FORMSPREE_ID = "xqerewpv"; // Replace with your actual Formspree ID

const stats = [
  { value: '150+', label: 'Properties Sold' },
  { value: '98%', label: 'Client Satisfaction' },
  { value: '12+', label: 'Years of Experience' },
  { value: '$50M+', label: 'In Transactions' },
];

const benefits = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
    title: 'Free Valuation',
    desc: 'We assess your property at no cost or commitment with experts in the Dominican market.'
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    title: 'Buyer Network',
    desc: 'Access thousands of active local and international buyers looking to invest in the DR.'
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    title: 'Premium Marketing',
    desc: 'Professional photography, virtual tours, and top-tier digital advertising campaigns.'
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>`,
    title: 'Legal Support',
    desc: 'Full guidance through every legal step and property documentation process.'
  },
];
---

<!DOCTYPE html>
<html lang="en" class="bg-offwhite text-slate-900">
<head>
    <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>List Your Property with Alexis RD | Premium Real Estate Dominican Republic</title>
  <meta name="description" content="Own property in the Dominican Republic? Partner with Alexis RD — 12+ years of local expertise, a global buyer network, and premium marketing to get you the best price." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col">

  <Navbar lang="en" currentPage="list-with-us" />

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"></div>
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-gold/5 translate-x-1/2 -translate-y-1/4 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-gold/5 -translate-x-1/2 translate-y-1/4 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-6">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
            Premium Property Listing
          </span>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight">
            Your property deserves
            <span class="text-gold block">the best price</span>
          </h1>

          <p class="mt-6 text-lg text-white/65 leading-relaxed max-w-lg">
            With 12+ years in the Dominican market, we connect your property with serious buyers and tenants — local and international. Stress-free, results-driven.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {stats.map(s => (
              <div class="bg-white/8 backdrop-blur-sm border border-white/10 rounded-xl px-5 py-3 text-center">
                <div class="text-2xl font-black text-gold">{s.value}</div>
                <div class="text-xs text-white/50 font-semibold uppercase tracking-wider mt-0.5">{s.label}</div>
              </div>
            ))}
          </div>

          <div class="mt-8 flex items-center gap-4">
            <a
              href={`https://wa.me/${WHATSAPP_PHONE}?text=${encodeURIComponent('Hi Alexis, I want to sell/rent my property and would like a free valuation.')}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-lg text-sm transition-all duration-200 shadow-lg shadow-emerald-600/20"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Direct
            </a>
            <a href="#form" class="text-gold font-semibold text-sm hover:text-amber-400 transition-colors flex items-center gap-1">
              Fill the Form
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>
        </div>

        <!-- Decorative card -->
        <div class="hidden lg:flex justify-center">
          <div class="relative">
            <div class="bg-white/5 backdrop-blur-md border border-white/15 rounded-2xl p-8 w-80 shadow-2xl">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 bg-gold/20 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
                </div>
                <div>
                  <div class="text-white font-bold text-sm">Property Listed</div>
                  <div class="text-white/40 text-xs">2 hours ago</div>
                </div>
              </div>
              <div class="space-y-3 mb-6">
                <div class="h-3 bg-white/10 rounded-full w-full"></div>
                <div class="h-3 bg-white/10 rounded-full w-3/4"></div>
                <div class="h-3 bg-white/8 rounded-full w-5/6"></div>
              </div>
              <div class="flex items-center justify-between bg-white/8 rounded-xl p-3">
                <span class="text-gold font-black text-lg">USD $320,000</span>
                <span class="bg-emerald-500/20 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-lg">Active</span>
              </div>
            </div>
            <div class="absolute -bottom-4 -right-4 bg-gold text-navy font-black text-sm px-5 py-3 rounded-xl shadow-lg shadow-gold/30 rotate-2">
              Free Valuation!
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="bg-white py-20 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">Why choose us?</h2>
        <p class="mt-3 text-warm-gray max-w-xl mx-auto">Everything you need to sell or rent at the best price, in the shortest time possible.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map(b => (
          <div class="group p-6 rounded-2xl border border-slate-100 hover:border-gold/30 hover:shadow-lg hover:shadow-navy/5 transition-all duration-300 bg-offwhite hover:bg-white">
            <div class="w-12 h-12 bg-navy/5 group-hover:bg-gold/10 rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
              <svg class="w-6 h-6 text-navy group-hover:text-gold transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={b.icon}></svg>
            </div>
            <h3 class="text-base font-bold text-navy mb-2">{b.title}</h3>
            <p class="text-sm text-warm-gray leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section id="form" class="py-20 bg-offwhite">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <span class="inline-block bg-gold/10 text-gold text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full border border-gold/20 mb-4">First Step</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">Tell us about your property</h2>
        <p class="mt-3 text-warm-gray max-w-xl mx-auto">
          Fill out the form and an Alexis RD specialist will contact you within 24 hours to schedule a free valuation.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl shadow-navy/5 border border-slate-100 overflow-hidden">
        <!-- Header bar -->
        <div class="bg-gradient-to-r from-navy to-[#0d2240] px-8 py-6 flex items-center gap-4">
          <div class="w-10 h-10 bg-gold/20 rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div>
            <div class="text-white font-bold text-base">Property Listing Form</div>
            <div class="text-white/50 text-xs">Secure data · Response within 24 hours</div>
          </div>
          <div class="ml-auto flex items-center gap-1.5">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
            <span class="text-emerald-400 text-xs font-semibold">Online</span>
          </div>
        </div>

        <form
          id="listing-form"
          action={`https://formspree.io/f/${FORMSPREE_ID}`}
          method="POST"
          class="p-8 md:p-10 space-y-6"
        >
          <!-- Hidden tracking field -->
          <input type="hidden" name="subject" value="New property submission from {{Nombre Completo}} - Alexis RD Real Estate" />
          <input type="hidden" name="Tipo de Formulario" value="Captación de Propiedad" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <!-- Full name -->
            <div class="flex flex-col gap-2">
              <label for="nombre" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Full Name <span class="text-gold">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="Nombre Completo"
                required
                placeholder="e.g. John Smith"
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              />
            </div>

            <!-- Email -->
            <div class="flex flex-col gap-2">
              <label for="email" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Email Address <span class="text-gold">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="Correo"
                required
                placeholder="you@email.com"
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              />
            </div>

            <!-- Phone -->
            <div class="flex flex-col gap-2">
              <label for="telefono" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Phone / WhatsApp <span class="text-gold">*</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="Teléfono"
                required
                placeholder="+1 (809) 000-0000"
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              />
            </div>

            <!-- Property Type -->
            <div class="flex flex-col gap-2">
              <label for="tipo-propiedad" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                Property Type <span class="text-gold">*</span>
              </label>
              <select
                id="tipo-propiedad"
                name="Tipo de Propiedad"
                required
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              >
                <option value="" disabled selected>Select type...</option>
                <option value="Apartment">Apartment</option>
                <option value="Villa">Villa</option>
                <option value="House">House</option>
                <option value="Penthouse">Penthouse</option>
                <option value="Lot / Land">Lot / Land</option>
                <option value="Commercial Space">Commercial Space</option>
                <option value="Office">Office</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Property Location -->
            <div class="flex flex-col gap-2">
              <label for="ubicacion" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                Property Location <span class="text-gold">*</span>
              </label>
              <input
                type="text"
                id="ubicacion"
                name="Ubicación de la Propiedad"
                required
                placeholder="e.g. Punta Cana, Dominican Republic"
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              />
            </div>

            <!-- Estimated Price -->
            <div class="flex flex-col gap-2">
              <label for="precio-estimado" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Estimated Price (USD)
              </label>
              <input
                type="text"
                id="precio-estimado"
                name="Precio Estimado"
                placeholder="e.g. $250,000 — or 'Not sure'"
                class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all"
              />
            </div>
          </div>

          <!-- Additional Details -->
          <div class="flex flex-col gap-2">
            <label for="detalles" class="text-xs font-bold text-navy uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              Additional Details
            </label>
            <textarea
              id="detalles"
              name="Detalles Adicionales"
              rows={4}
              placeholder="Tell us more: square footage, bedrooms, current condition, furnished status, whether you want to sell or rent, your timeline, etc."
              class="bg-offwhite border border-slate-200 rounded-xl px-4 py-3 text-sm text-navy placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition-all resize-none"
            ></textarea>
          </div>

          <!-- Privacy note -->
          <p class="text-xs text-slate-400 flex items-start gap-2">
            <svg class="w-4 h-4 text-gold/60 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Your information is confidential and will only be used to contact you with a personalized proposal. We never share your data with third parties.
          </p>

          <!-- Submit -->
          <button
            type="submit"
            id="btn-submit-listing"
            class="w-full bg-[#0B192C] border border-[#C9A84C]/20 hover:bg-[#C9A84C] hover:text-[#0B192C] hover:shadow-md hover:shadow-[#C9A84C]/20 hover:-translate-y-0.5 active:scale-[0.98] text-white font-bold py-4 rounded-xl text-base tracking-wide uppercase transition-all duration-300 ease-in-out flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            Submit Free Request
          </button>

          <div id="form-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl px-5 py-4 text-sm font-semibold flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Request submitted! Alexis will be in touch within 24 hours.
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-800 rounded-xl px-5 py-4 text-sm font-semibold flex items-center gap-3">
            <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            An error occurred. Please contact us directly on WhatsApp.
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="bg-navy py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-extrabold text-white">How it works</h2>
        <p class="mt-3 text-white/50 max-w-xl mx-auto">A simple, transparent, and effective process.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <div class="hidden md:block absolute top-10 left-[12.5%] right-[12.5%] h-0.5 bg-gold/20 z-0"></div>
        {[
          { n: '01', t: 'Submit Request', d: 'Fill out the form with your property\'s basic details.' },
          { n: '02', t: 'Free Valuation', d: 'An expert evaluates your property and presents a price proposal.' },
          { n: '03', t: 'Premium Marketing', d: 'We list with professional photography and multi-channel distribution.' },
          { n: '04', t: 'Successful Close', d: 'We guide you through to a safe and successful transaction.' },
        ].map(step => (
          <div class="relative z-10 text-center">
            <div class="w-20 h-20 bg-gold/10 border border-gold/25 rounded-2xl flex items-center justify-center mx-auto mb-5">
              <span class="text-gold font-black text-2xl">{step.n}</span>
            </div>
            <h3 class="text-white font-bold text-base mb-2">{step.t}</h3>
            <p class="text-white/45 text-xs leading-relaxed">{step.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <AccessibilityWidget lang="en" />

  <script>
    const form = document.getElementById('listing-form') as HTMLFormElement | null;
    const btnSubmit = document.getElementById('btn-submit-listing');
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;

      btnSubmit?.setAttribute('disabled', 'true');
      if (btnSubmit) btnSubmit.textContent = 'Submitting...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
          errorMsg?.classList.add('hidden');
          successMsg?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('Response not OK');
        }
      } catch {
        errorMsg?.classList.remove('hidden');
        successMsg?.classList.add('hidden');
      } finally {
        btnSubmit?.removeAttribute('disabled');
        if (btnSubmit) btnSubmit.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Submit Free Request`;
      }
    });
  </script>

</body>
</html>
