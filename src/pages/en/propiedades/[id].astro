---
import { getCollection, getEntry } from "astro:content";
import "../../../styles/global.css";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import AccessibilityWidget from "../../../components/AccessibilityWidget.astro";
import { Image } from "astro:assets";
import * as deepl from "deepl-node";
import { resolverPrecios } from "../../../utils/currency";

const { id } = Astro.params;

// Intentar recuperar directamente por ID primero
let entry = await getEntry("propiedades", id || "");

// Si no se encuentra (debido a diferencias de casing/slug en Keystatic), buscamos en la colección por slug
if (!entry && id) {
  const todas = await getCollection("propiedades");
  entry = todas.find((item) => {
    const slugSeguro = item.id
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]/g, "-");
    return slugSeguro === id;
  });
}

if (!entry) {
  return Astro.redirect("/404");
}

const idPropiedad = entry.id;

// 2. RESOLVER IMÁGENES Y GALERÍA (Con casting dinámico seguro "as any[]")
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP}",
  { eager: true },
);
const dataPlana = entry.data as any;
const galeriaRaw = dataPlana.galeria || [];

const fotosGaleria = galeriaRaw
  .map((rutaRaw: string) => {
    const rutaPublica = String(rutaRaw || "").replace(/^\.\.\/\.\.\//, "/src/");
    return imagenes[rutaPublica]?.default || null;
  })
  .filter(Boolean) as any[];

const rutaPrincipal = String(entry.data.imagenPrincipal || "").replace(
  /^\.\.\/\.\.\//,
  "/src/",
);
const imagenPrincipalResuelta = imagenes[rutaPrincipal]?.default || null;

// 3. CONFIGURACIÓN DE LA API DE TRADUCCIÓN (DEEPL SHIELD)
const DEEPL_AUTH_KEY = "cfcc4e7f-2356-4f78-a8e3-3bc2bc6aafb4:fx";
let translator: any = null;

try {
  if (DEEPL_AUTH_KEY) {
    translator = new deepl.Translator(DEEPL_AUTH_KEY);
  }
} catch (e) {
  console.error("Error al inicializar el traductor en detalle:", e);
}

// Datos base en español recolectados del JSON
const tituloOriginal = entry.data.titulo || idPropiedad.replace(/-/g, " ");
const descripcionOriginal = entry.data.descripcion || "";
const tipoOriginal = entry.data.tipo || "Apartamento";
const estadoOriginal = entry.data.estado || "En planos";

// 🌟 INTEGRACIÓN DEL TRADUCTOR INVISIBLE
let tituloTraducido = entry.data.titulo_en || "";
let descripcionTraducida = entry.data.descripcion_en || "";
let tipoTraducido = "";
let estadoTraducido = "";

if (translator) {
  try {
    // Traducir el título si vino vacío de Keystatic
    if (!tituloTraducido) {
      const resTitulo = await translator.translateText(
        tituloOriginal,
        null,
        "en-US",
      );
      tituloTraducido = resTitulo.text;
    }

    // Traducir la descripción si vino vacía de Keystatic
    if (!descripcionTraducida) {
      if (descripcionOriginal) {
        const resDesc = await translator.translateText(
          descripcionOriginal,
          null,
          "en-US",
        );
        descripcionTraducida = resDesc.text;
      } else {
        descripcionTraducida =
          "Discover this amazing real estate opportunity in the Dominican Republic.";
      }
    }

    // El tipo y el estado del proyecto se traducen siempre
    const resTipo = await translator.translateText(tipoOriginal, null, "en-US");
    tipoTraducido = resTipo.text;

    const resEstado = await translator.translateText(
      estadoOriginal,
      null,
      "en-US",
    );
    estadoTraducido = resEstado.text;
  } catch (error) {
    console.warn(
      `[DeepL Detail Shield] Fallo en traducción dinámica para ${id}. Desplegando fallbacks.`,
    );
    if (!tituloTraducido) tituloTraducido = tituloOriginal;
    if (!descripcionTraducida)
      descripcionTraducida =
        descripcionOriginal || "Discover this amazing real estate opportunity.";
    tipoTraducido = tipoOriginal;
    estadoTraducido = estadoOriginal;
  }
} else {
  if (!tituloTraducido) tituloTraducido = tituloOriginal;
  if (!descripcionTraducida)
    descripcionTraducida =
      descripcionOriginal || "Discover this amazing real estate opportunity.";
  tipoTraducido = tipoOriginal;
  estadoTraducido = estadoOriginal;
}

const { usd: precioUsd, dop: precioDop } = resolverPrecios(
  dataPlana.precioUsd,
  dataPlana.precioDop
);
const ubicacion = entry.data.ubicacion || "Dominican Republic";
const confotur = Boolean(entry.data.confotur);
const habitaciones = Number(entry.data.habitaciones) || 0;
const banos = Number(entry.data.banos) || 0;
const parqueos = Number(entry.data.parqueos) || 0;
// 🚀 CORRECCIÓN: Usamos dataPlana para saltar la validación estricta de TypeScript temporalmente
const latitud = Number(dataPlana.latitud) || 18.47186;
const longitud = Number(dataPlana.longitud) || -69.89232;
const WHATSAPP_PHONE = "18295259993";
---

<!doctype html>
<html lang="en" class="bg-offwhite text-slate-900">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Título de la pestaña en Google -->
    <title>{tituloTraducido} | Alexis RD Real Estate</title>

    <!-- Descripción para buscadores -->
    <meta
      name="description"
      content={`Exclusive property in ${ubicacion}. Price: USD $${precioUsd.toLocaleString("en-US")} / RD$ ${precioDop.toLocaleString("es-DO")}. Beds: ${habitaciones} | Baths: ${banos}. View details, photos and location map.`}
    />

    <!-- Metadatos de Redes Sociales y WhatsApp (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={`${tituloTraducido} | Alexis RD Real Estate`}
    />
    <meta
      property="og:description"
      content={`Investment Opportunity in ${ubicacion}. Price: USD $${precioUsd.toLocaleString("en-US")} / RD$ ${precioDop.toLocaleString("es-DO")}. Click for full details and photos.`}
    />
    <meta
      property="og:image"
      content={String(entry.data.imagenPrincipal || "").replace(
        "../../",
        "/src/",
      )}
    />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Leaflet Assets (Mapas) -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
      is:inline></script>
  </head>

  <body class="min-h-screen flex flex-col bg-offwhite">
    <Navbar lang="en" />

    <!-- Main Content -->
    <main
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-10 flex-1 w-full"
    >
      <!-- Breadcrumb -->
      <div class="mb-6">
        <a
          href="/en"
          class="text-sm text-warm-gray hover:text-gold transition-colors flex items-center gap-2 font-medium"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path></svg
          >
          Back to catalog
        </a>
      </div>

      <!-- Header -->
      <div class="border-b border-slate-200 pb-6 mb-8">
        <div
          class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider mb-3"
        >
          <span class="bg-navy text-gold px-2.5 py-1 rounded"
            >{tipoTraducido}</span
          >
          <span class="bg-gold text-navy px-2.5 py-1 rounded"
            >{estadoTraducido}</span
          >
          {
            confotur && (
              <span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded border border-emerald-200">
                Confotur Tax Benefit
              </span>
            )
          }
        </div>
        <h1
          class="text-3xl font-extrabold text-navy sm:text-4xl tracking-tight leading-tight"
        >
          {tituloTraducido}
        </h1>
        <p class="mt-2 text-lg text-warm-gray flex items-center gap-1.5">
          <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path></svg
          >
          {ubicacion}
        </p>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- LEFT COLUMN -->
        <div class="lg:col-span-2 space-y-6">
          <div class="space-y-6">
            <div
              class="w-full rounded-xl overflow-hidden bg-slate-100 shadow-sm relative aspect-video md:aspect-[21/9]"
            >
              {
                imagenPrincipalResuelta ? (
                  <Image
                    src={imagenPrincipalResuelta}
                    alt={tituloTraducido || "ALEXIS REAL ESTATE RD... Property"}
                    width={1200}
                    height={514}
                    format="webp"
                    loading="eager"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center bg-slate-100 text-slate-400">
                    <svg
                      class="w-12 h-12 mb-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    <span class="text-xs font-semibold">
                      No image available
                    </span>
                  </div>
                )
              }
            </div>

            <!-- Galería de fotos secundarias en Inglés -->
            {
              fotosGaleria.length > 0 && (
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                  <h3 class="text-xl font-bold text-navy mb-4 border-b border-slate-100 pb-2">
                    Property Gallery
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    {fotosGaleria.map((imgMeta, index) => (
                      <div class="aspect-video overflow-hidden rounded-xl border border-slate-200 shadow-sm group cursor-pointer">
                        <Image
                          src={imgMeta}
                          alt={`Photo ${index + 1} of ${tituloTraducido}`}
                          format="webp"
                          quality={75}
                          class="object-cover w-full h-full hover:scale-105 transition-transform duration-200"
                        />
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h2
              class="text-xl font-bold text-navy mb-4 border-b border-slate-100 pb-2"
            >
              Property Description
            </h2>
            <p
              class="text-slate-600 leading-relaxed text-base whitespace-pre-line"
            >
              {descripcionTraducida}
            </p>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="space-y-6">
          <!-- Price -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center"
          >
            <span
              class="text-xs font-bold text-warm-gray uppercase tracking-widest"
              >Investment Price</span
            >
            <div class="text-3xl font-black text-navy mt-1">
              USD ${precioUsd.toLocaleString("en-US")}
            </div>
            <div class="text-lg font-bold text-warm-gray mb-6">
              RD$ {precioDop.toLocaleString("es-DO")}
            </div>
            <a
              href={`https://wa.me/${WHATSAPP_PHONE}?text=Hi%20Alexis,%20I%20am%20requesting%20personalized%20advisory%20and%20financial%20details%20for%20the%20property:%20"${encodeURIComponent(tituloTraducido)}".`}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 rounded-xl text-sm transition-colors shadow-md text-center flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path></svg
              >
              Schedule Appointment via WhatsApp
            </a>
          </div>

          <!-- Lead Capture (Resend API Marca Blanca) -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h3
              class="font-bold text-navy text-sm uppercase tracking-wider mb-1 flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              Request Information
            </h3>
            <p class="text-xs text-warm-gray mb-4">
              Send a formal structured inquiry about this property.
            </p>

            <form id="contact-form" class="space-y-3.5">
              <!-- Datos dinámicos listos para el motor de Resend -->
              <input
                type="hidden"
                name="property_title"
                value={tituloTraducido}
              />
              <input type="hidden" name="property_url" value={Astro.url.href} />
              <input
                type="hidden"
                name="form_type"
                value="English Property Inquiry"
              />

              <div id="form-fields" class="space-y-3.5">
                <div>
                  <label
                    class="block text-[11px] font-bold text-navy uppercase tracking-wider mb-1"
                    for="nombre">Full Name</label
                  >
                  <input
                    type="text"
                    id="nombre"
                    name="name"
                    required
                    class="w-full px-3 py-2 bg-offwhite border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-gold transition-colors text-slate-800"
                    placeholder="e.g. John Doe"
                  />
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-3">
                  <div>
                    <label
                      class="block text-[11px] font-bold text-navy uppercase tracking-wider mb-1"
                      for="email">Email</label
                    >
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-3 py-2 bg-offwhite border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-gold transition-colors text-slate-800"
                      placeholder="john@mail.com"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-[11px] font-bold text-navy uppercase tracking-wider mb-1"
                      for="telefono">Phone</label
                    >
                    <input
                      type="tel"
                      id="telefono"
                      name="phone"
                      required
                      class="w-full px-3 py-2 bg-offwhite border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-gold transition-colors text-slate-800"
                      placeholder="829-555-5555"
                    />
                  </div>
                </div>

                <div>
                  <label
                    class="block text-[11px] font-bold text-navy uppercase tracking-wider mb-1"
                    for="mensaje">Message</label
                  >
                  <textarea
                    id="mensaje"
                    name="message"
                    rows="3"
                    required
                    class="w-full px-3 py-2 bg-offwhite border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-gold transition-colors text-slate-800 resize-none"
                    placeholder="Hi Alexis, I would like to receive more details about availability and financing for this property..."
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full bg-[#0B192C] border border-[#C9A84C]/20 hover:bg-[#C9A84C] hover:text-[#0B192C] hover:shadow-lg hover:shadow-[#C9A84C]/25 active:scale-[0.98] text-white font-bold py-3.5 rounded-xl text-xs transition-all duration-300 ease-in-out uppercase tracking-widest shadow-md focus:outline-none"
                >
                  Send Message by Email
                </button>
              </div>

              <div
                id="form-feedback"
                class="hidden p-4 rounded-xl text-xs font-semibold text-center mt-3"
              >
              </div>
            </form>
          </div>

          <!-- Features -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h3
              class="font-bold text-navy mb-4 text-sm uppercase tracking-wider text-center sm:text-left"
            >
              Features
            </h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center"
              >
                <svg
                  class="w-6 h-6 text-gold mx-auto"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"
                  ></path></svg
                >
                <span class="block font-bold text-navy mt-1"
                  >{habitaciones} Beds</span
                >
              </div>
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center"
              >
                <svg
                  class="w-6 h-6 text-gold mx-auto"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4"
                  ></path></svg
                >
                <span class="block font-bold text-navy mt-1">{banos} Baths</span
                >
              </div>
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center col-span-2"
              >
                <span class="font-semibold text-warm-gray"
                  >Available Parking spaces:</span
                >
                <span class="font-bold text-navy ml-1">{parqueos}</span>
              </div>
            </div>
          </div>

          <!-- Map -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h2
              class="text-sm font-bold text-navy uppercase tracking-wider mb-4 border-b border-slate-100 pb-2 flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-gold"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path></svg
              >
              Property Location
            </h2>
            <div
              id="map-individual"
              class="w-full h-64 rounded-xl border border-slate-200 shadow-inner z-10"
            >
            </div>
          </div>

          <!-- Calculator -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h3
              class="text-lg font-bold text-navy mb-1 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5 text-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path></svg
              >
              Smart Investment Calculator
            </h3>
            <p class="text-xs text-warm-gray mb-4">
              Plan your estimated closing budget structure.
            </p>

            <div class="space-y-4">
              <div>
                <div
                  class="flex justify-between text-xs font-semibold text-slate-700 mb-1"
                >
                  <label for="range-inicial">Down Payment Percentage:</label>
                  <span id="display-porcentaje" class="text-gold font-bold"
                    >20%</span
                  >
                </div>
                <input
                  type="range"
                  id="range-inicial"
                  min="20"
                  max="100"
                  step="5"
                  value="20"
                  class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-gold"
                />
              </div>

              <div
                class="bg-offwhite rounded-xl p-4 border border-slate-100 space-y-3 text-xs"
              >
                <div
                  class="flex justify-between border-b border-slate-200 pb-2"
                >
                  <span class="text-slate-600">Down Payment Amount:</span>
                  <span class="font-bold text-navy" id="calc-inicial"
                    >USD $0</span
                  >
                </div>
                <div
                  class="flex justify-between border-b border-slate-200 pb-2"
                >
                  <span class="text-slate-600">Mortgage Loan Amount:</span>
                  <span class="font-bold text-navy" id="calc-prestamo"
                    >USD $0</span
                  >
                </div>
                <div class="flex flex-col gap-1 pt-1">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-600">3% DGII Transfer Tax:</span>
                    <span class="font-bold text-navy" id="calc-dgii"
                      >USD $0</span
                    >
                  </div>
                  {
                    confotur && (
                      <span class="self-start bg-emerald-100 text-emerald-800 text-[10px] font-bold px-1.5 py-0.5 rounded mt-1">
                        Waived via Confotur Law Incentive
                      </span>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer lang="en" />
    <AccessibilityWidget lang="en" />

    <script
      is:inline
      define:vars={{
        lat: latitud,
        lng: longitud,
        titulo: tituloTraducido,
        precioPropiedad: precioUsd,
        tieneConfotur: confotur,
      }}
    >
      const initProptechModulesEn = () => {
        const mapaContenedor = document.getElementById("map-individual");
        if (mapaContenedor && typeof L !== "undefined") {
          const validLat = Number(lat) || 18.4231;
          const validLng = Number(lng) || -69.4124;
          const map = L.map("map-individual").setView([validLat, validLng], 14);

          L.tileLayer(
            "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
            {
              attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            },
          ).addTo(map);

          const marker = L.marker([validLat, validLng]).addTo(map);
          marker
            .bindPopup(
              `<b style="font-family: 'Inter', sans-serif; color: #0B192C;">${titulo}</b>`,
            )
            .openPopup();

          setTimeout(() => {
            map.invalidateSize();
          }, 300);
        }

        const rangeInicial = document.getElementById("range-inicial");
        const displayPorcentaje = document.getElementById("display-porcentaje");
        const calcInicial = document.getElementById("calc-inicial");
        const calcPrestamo = document.getElementById("calc-prestamo");
        const calcDgii = document.getElementById("calc-dgii");

        if (
          rangeInicial &&
          displayPorcentaje &&
          calcInicial &&
          calcPrestamo &&
          calcDgii
        ) {
          function calcular() {
            const porcentaje = parseInt(rangeInicial.value, 10);
            displayPorcentaje.textContent = `${porcentaje}%`;

            const inicial = precioPropiedad * (porcentaje / 100);
            const prestamo = precioPropiedad - inicial;
            const impuestoDGII = tieneConfotur ? 0 : precioPropiedad * 0.03;

            calcInicial.textContent = `USD $${Math.round(inicial).toLocaleString("en-US")}`;
            calcPrestamo.textContent = `USD $${Math.round(prestamo).toLocaleString("en-US")}`;
            calcDgii.textContent =
              impuestoDGII === 0
                ? "EXEMPT"
                : `USD $${Math.round(impuestoDGII).toLocaleString("en-US")}`;
          }
          rangeInicial.addEventListener("input", calcular);
          calcular();
        }

        // --- ASYNCHRONOUS LOCAL API HANDLER (WHITE-LABEL RESEND) ---
        const contactForm = document.getElementById("contact-form");
        const feedback = document.getElementById("form-feedback");
        if (contactForm && feedback) {
          contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = contactForm.querySelector(
              "button[type='submit']",
            );
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = "Sending...";
            submitBtn.style.opacity = "0.7";
            feedback.classList.add("hidden");
            feedback.className =
              "p-4 rounded-xl text-xs font-semibold text-center mt-3";

            try {
              // 🚀 Apuntamos directamente a nuestro endpoint local de Astro
              const res = await fetch("/api/contacto", {
                method: "POST",
                body: new FormData(contactForm),
              });

              const result = await res.json();

              if (res.ok && result.success) {
                contactForm.reset();
                const formFields = contactForm.querySelector("#form-fields");
                if (formFields) formFields.classList.add("hidden");
                feedback.innerHTML = `<span class="flex items-center justify-center gap-1.5 font-bold">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Thank you! Your message has been sent successfully.
                </span>`;
                feedback.classList.remove("hidden");
                feedback.classList.add(
                  "bg-emerald-500/10",
                  "border",
                  "border-emerald-500/30",
                  "text-emerald-600",
                );
              } else {
                throw new Error();
              }
            } catch (err) {
              feedback.innerHTML = `<span class="flex items-center justify-center gap-1.5 text-rose-800">
                <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                An error occurred. Please retry or contact us via WhatsApp.
              </span>`;
              feedback.classList.remove("hidden");
              feedback.classList.add("bg-rose-50", "border", "border-rose-200");
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
              submitBtn.style.opacity = "";
            }
          });
        }
      };

      document.addEventListener("DOMContentLoaded", initProptechModulesEn);
      document.addEventListener("astro:page-load", initProptechModulesEn);
    </script>
  </body>
</html>
