---
// src/pages/guias/comprar-en-republica-dominicana-desde-espana.astro
import GuiaLayout from '../../layouts/GuiaLayout.astro';
import IndiceContenido from '../../components/guias/IndiceContenido.astro';
import CajaAlertaJuridica from '../../components/guias/CajaAlertaJuridica.astro';
import TarjetasMetricasFiscales from '../../components/guias/TarjetasMetricasFiscales.astro';
import BannerWhatsappGuia from '../../components/guias/BannerWhatsappGuia.astro';
import TablaComparativaFiscal from '../../components/guias/TablaComparativaFiscal.astro';
import CajaProyeccionFinanciera from '../../components/guias/CajaProyeccionFinanciera.astro';
---

<GuiaLayout
  titulo="Guía Definitiva: Cómo Comprar e Invertir en Bienes Raíces en República Dominicana desde España (2026)"
  metaDescripcion="Todo lo que un inversionista español necesita saber para adquirir propiedades en RD: requisitos legales, poder notarial consular, título deslindado, transferencias EUR-USD, exenciones Confotur y rentabilidad en alquiler vacacional."
  categoria="Inversión Internacional"
  tiempoLectura="18 min"
  fechaActualizacion="2026-08-24"
>

  <!-- ─── ÍNDICE INTERACTIVO DE CONTENIDO ─── -->
  <IndiceContenido />

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 1 — Requisitos Legales para Españoles
       ═══════════════════════════════════════════════════════════════ -->
  <section id="requisitos" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 01</span>
      <span>•</span>
      <span>Marco Legal</span>
    </div>
    <h2>1. Requisitos Legales para Comprar Propiedad siendo Español</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> Los ciudadanos españoles tienen exactamente los mismos derechos de compra que los dominicanos, sin necesidad de residencia ni visado especial. Solo se requiere pasaporte en vigor.
    </div>

    <p>
      La República Dominicana garantiza igualdad jurídica total para la inversión extranjera. No existen zonas costeras restringidas ni limitaciones por nacionalidad sobre la titularidad del suelo.
    </p>

    <h3 class="!mt-5">Checklist de Documentación Requerida</h3>

    <!-- Checklist visual -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-4">
      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Pasaporte en vigor</span>
          <span class="text-[11px] text-slate-500">Único documento de identidad obligatorio para la compraventa.</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">RNC Provisional (DGII)</span>
          <span class="text-[11px] text-slate-500">Asignado de forma automática por la administración tributaria.</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Contrato de Compraventa</span>
          <span class="text-[11px] text-slate-500">Redactado o revisado por abogado inmobiliario dominicano.</span>
        </div>
      </div>

      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Poder Especial Notariado</span>
          <span class="text-[11px] text-slate-500">Solo en caso de realizar la firma a distancia desde España.</span>
        </div>
      </div>
    </div>

    <CajaAlertaJuridica tipo="info" titulo="Beneficio Adicional: Residencia por Inversión">
      Las inversiones inmobiliarias iguales o superiores a <strong>USD $200,000</strong> permiten solicitar la Residencia Definitiva por Inversión en República Dominicana mediante trámite ágil ante Migración.
    </CajaAlertaJuridica>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 2 — Poder Notarial Consular
       ═══════════════════════════════════════════════════════════════ -->
  <section id="poder-consular" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 02</span>
      <span>•</span>
      <span>Firma Remota</span>
    </div>
    <h2>2. Firma a Distancia: Poder Notarial Consular y Apostilla de La Haya</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> No necesitas viajar a República Dominicana para comprar. Puedes formalizar toda la operación legal desde España mediante dos vías oficiales seguras.
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
      <!-- Vía 1 -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <span class="w-7 h-7 rounded-lg bg-navy text-gold font-black text-xs flex items-center justify-center">A</span>
        <h4 class="font-bold text-sm text-navy">Consulados de RD en España</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Preséntate en los consulados de <strong>Madrid, Barcelona o Sevilla</strong>. El poder notarial emitido tiene validez legal directa e inmediata en República Dominicana.
        </p>
      </div>

      <!-- Vía 2 -->
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <span class="w-7 h-7 rounded-lg bg-navy text-gold font-black text-xs flex items-center justify-center">B</span>
        <h4 class="font-bold text-sm text-navy">Notario Español + Apostilla</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          Otorga poder especial ante cualquier notario en España y añade la <strong>Apostilla de La Haya</strong> en el Colegio Notarial. Reconocimiento internacional garantizado.
        </p>
      </div>
    </div>

    <CajaAlertaJuridica tipo="warning" titulo="Recomendación Jurídica sobre el Poder">
      El poder notarial debe ser <strong>especial y limitado</strong> al inmueble específico, precio y actos autorizados. Evita otorgar poderes generales de administración.
    </CajaAlertaJuridica>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 3 — Título Deslindado y Seguridad Jurídica
       ═══════════════════════════════════════════════════════════════ -->
  <section id="titulo-deslindado" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 03</span>
      <span>•</span>
      <span>Garantía Patrimonial</span>
    </div>
    <h2>3. Seguridad Jurídica: ¿Qué es el Título Deslindado y Por Qué es Imprescindible?</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> En el sistema registral dominicano, el Título Deslindado es la única prueba inatacable de propiedad individual. Comprar sin deslinde equivale a asumir riesgos de ocupación o litigios.
    </div>

    <p>
      El <strong>Certificado de Título Deslindado</strong> emitido por el Registro de Títulos certifica con coordenadas georreferenciadas los límites exactos y la propiedad exclusiva del inmueble.
    </p>

    <!-- Caja de alerta crítica -->
    <CajaAlertaJuridica tipo="warning" titulo="Regla de Oro: Nunca compres derechos posesorios sin Título Deslindado">
      Las "constancias anotadas" o derechos posesorios <strong>no son títulos de propiedad</strong>. No permiten acceso a préstamos bancarios, no pueden asegurarse ante catástrofes y conllevan procesos de regularización largos y costosos. Exige siempre la <strong>Certificación de Estado Jurídico</strong> emitida por el Registro de Títulos.
    </CajaAlertaJuridica>

    <h3 class="!mt-5">Garantías del Título Deslindado vs. Derechos Posesorios</h3>

    <div class="overflow-x-auto my-4">
      <table class="w-full text-xs text-left">
        <thead class="bg-slate-50 text-navy font-bold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="p-3">Aspecto</th>
            <th class="p-3 text-emerald-700">Título Deslindado</th>
            <th class="p-3 text-red-600">Derecho Posesorio</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-600">
          <tr>
            <td class="p-3 font-semibold text-navy">Respaldo Registral</td>
            <td class="p-3 text-emerald-700 font-semibold">Inatacable (Sistema Torrens)</td>
            <td class="p-3 text-red-600 font-medium">Provisional / Precario</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-navy">Financiamiento Bancario</td>
            <td class="p-3 text-emerald-700 font-semibold">Aceptado por todos los bancos</td>
            <td class="p-3 text-red-600 font-medium">Rechazado al 100%</td>
          </tr>
          <tr>
            <td class="p-3 font-semibold text-navy">Seguridad de Reventa</td>
            <td class="p-3 text-emerald-700 font-semibold">Inmediata y transparente</td>
            <td class="p-3 text-red-600 font-medium">Riesgo alto de litigio</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 4 — Transferencia de Divisas EUR → USD
       ═══════════════════════════════════════════════════════════════ -->
  <section id="divisas-bancos" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 04</span>
      <span>•</span>
      <span>Flujo Monetario</span>
    </div>
    <h2>4. Transferencia de Divisas: De Euros a Dólares y Cuentas Fiduciarias (Escrow)</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> Las transacciones inmobiliarias turísticas en RD se cotizan y liquidan en USD. Las cuentas de custodia fiduciaria (Escrow) protegen el capital hasta la entrega de la unidad.
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-4">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center space-y-1">
        <span class="text-gold font-bold text-xs uppercase tracking-wider block">Canal 1</span>
        <h4 class="font-bold text-xs text-navy">Transferencia SWIFT</h4>
        <p class="text-[11px] text-slate-500">Directa desde tu banco en España hacia la cuenta fiduciaria en RD.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center space-y-1">
        <span class="text-gold font-bold text-xs uppercase tracking-wider block">Canal 2</span>
        <h4 class="font-bold text-xs text-navy">Brokers de Divisas</h4>
        <p class="text-[11px] text-slate-500">Tipos de cambio EUR/USD más ajustados para importes superiores a 50k €.</p>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center space-y-1">
        <span class="text-gold font-bold text-xs uppercase tracking-wider block">Canal 3</span>
        <h4 class="font-bold text-xs text-navy">Cuenta Fiduciaria (Escrow)</h4>
        <p class="text-[11px] text-slate-500">Fondos bloqueados hasta el cumplimiento de los hitos de entrega.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 5 — Ley Confotur 158-01 y Fiscalidad
       ═══════════════════════════════════════════════════════════════ -->
  <section id="ley-confotur" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 05</span>
      <span>•</span>
      <span>Incentivos Fiscales</span>
    </div>
    <h2>5. Fiscalidad e Incentivos: La Ley 158-01 (Confotur)</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> Los proyectos amparados bajo la Ley Confotur están 100% exonerados del 3% de transferencia y del 1% anual de IPI durante 15 años consecutivos.
    </div>

    <!-- Tarjetas de métricas destacadas -->
    <TarjetasMetricasFiscales />

    <p>
      El Consejo de Fomento Turístico (Confotur) otorga estas exenciones para dinamizar la inversión en polos de alto desarrollo como Punta Cana, Bávaro, Cap Cana y Las Terrenas.
    </p>

    <!-- Tabla comparativa fiscal -->
    <TablaComparativaFiscal />
  </section>

  <!-- Banner WhatsApp colocado estratégicamente tras el módulo fiscal -->
  <BannerWhatsappGuia
    badge="Asesoría Legal y Fiscal"
    titulo="¿Deseas verificar si un proyecto cuenta con Ley Confotur?"
    subtitulo="Te facilitamos la resolución oficial del Consejo de Fomento Turístico y confirmamos las exenciones antes de que reserves."
    mensaje="Hola Alexis, me gustaría verificar proyectos con Ley Confotur disponibles para inversión desde España."
  />

  <!-- ═══════════════════════════════════════════════════════════════
       MÓDULO 6 — Property Management y ROI
       ═══════════════════════════════════════════════════════════════ -->
  <section id="rentabilidad-roi" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 06</span>
      <span>•</span>
      <span>Rentas y Retorno</span>
    </div>
    <h2>6. Gestión de Alquiler Vacacional y Retorno de Inversión (ROI)</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> Con ocupaciones medias del 70%-80% en polos turísticos, los operadores de Property Management gestionan reservas, limpieza y liquidación neta sin que tengas que desplazarte.
    </div>

    <!-- Caja de proyección financiera -->
    <CajaProyeccionFinanciera
      precioDesde="85,000"
      moneda="USD"
      roiMinimo={8}
      roiMaximo={12}
    />

    <h3 class="!mt-6">Pilares del Property Management Integral</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-4">
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-2.5">
        <span class="w-5 h-5 rounded-md bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Comercialización Multicanal</span>
          <span class="text-[11px] text-slate-500">Listado en Airbnb, Booking y canales directos con precios dinámicos.</span>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-2.5">
        <span class="w-5 h-5 rounded-md bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Atención al Huésped 24/7</span>
          <span class="text-[11px] text-slate-500">Check-in automatizado, recepción y conserjería durante la estancia.</span>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-2.5">
        <span class="w-5 h-5 rounded-md bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Mantenimiento y Limpieza</span>
          <span class="text-[11px] text-slate-500">Supervisión técnica de la propiedad y reposición tras cada estancia.</span>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-2.5">
        <span class="w-5 h-5 rounded-md bg-gold/20 text-gold flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
        </span>
        <div>
          <span class="font-bold text-xs text-navy block">Liquidación Mensual en USD</span>
          <span class="text-[11px] text-slate-500">Informe transparente de ingresos y transferencia directa a tu cuenta.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       CONCLUSIÓN Y CTA FINAL
       ═══════════════════════════════════════════════════════════════ -->
  <section class="guia-modulo">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Resumen Final</span>
      <span>•</span>
      <span>Hoja de Ruta</span>
    </div>
    <h2>Conclusión: Pasos Clave para Invertir con Éxito</h2>

    <div class="space-y-2.5 my-4">
      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-navy text-gold font-black text-xs flex items-center justify-center shrink-0">1</span>
        <span class="text-xs text-slate-700 font-medium">Verifica la existencia del <strong>Título Deslindado</strong> y la resolución Confotur.</span>
      </div>
      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-navy text-gold font-black text-xs flex items-center justify-center shrink-0">2</span>
        <span class="text-xs text-slate-700 font-medium">Otorga <strong>poder especial notariado</strong> si realizas la firma remota desde España.</span>
      </div>
      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
        <span class="w-6 h-6 rounded-full bg-navy text-gold font-black text-xs flex items-center justify-center shrink-0">3</span>
        <span class="text-xs text-slate-700 font-medium">Asegura tus fondos mediante <strong>cuenta fiduciaria bancaria</strong> hasta la entrega.</span>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <BannerWhatsappGuia
    badge="Atención Personalizada"
    titulo="¿Listo para dar el primer paso en tu inversión?"
    subtitulo="Agenda una llamada de asesoramiento individual para seleccionar las mejores propiedades y proyectos Confotur en República Dominicana."
    mensaje="Hola Alexis, soy inversionista desde España y tras revisar la guía completa me gustaría agendar una consulta personalizada."
  />

  <!-- Disclaimer legal -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 mb-4">
    <p class="text-[11px] text-slate-400 leading-relaxed">
      <strong class="text-slate-500">Aviso legal:</strong> El contenido de esta guía tiene carácter estrictamente informativo y educativo. No constituye asesoría legal, fiscal ni financiera formal. Las leyes, tasas impositivas y condiciones de mercado corresponden a la normativa vigente en República Dominicana y están sujetas a variaciones. Se recomienda asesoramiento con abogado y asesor fiscal antes de formalizar transacciones.
    </p>
  </div>

</GuiaLayout>
