---
// src/pages/guias/prestamos-hipotecarios-no-residentes-republica-dominicana.astro
import GuiaLayout from "../../layouts/GuiaLayout.astro";
import IndiceContenido, { type ItemIndice } from "../../components/guias/IndiceContenido.astro";
import CajaAlertaJuridica from "../../components/guias/CajaAlertaJuridica.astro";
import BannerWhatsappGuia from "../../components/guias/BannerWhatsappGuia.astro";

const itemsIndice: ItemIndice[] = [
  { id: "puedo-calificar", titulo: "1. ¿Puedo Calificar siendo Extranjero?", tipoIcono: "globe" },
  { id: "condiciones-credito", titulo: "2. Montos, Tasas y Plazos", tipoIcono: "chart" },
  { id: "requisitos-documentos", titulo: "3. Documentación Requerida", tipoIcono: "doc" },
  { id: "bancos-autorizados", titulo: "4. Principales Bancos en RD", tipoIcono: "bank" },
  { id: "paso-a-paso", titulo: "5. Proceso de Pre-Calificación", tipoIcono: "pen" }
];
---

<GuiaLayout
  titulo="Préstamos Hipotecarios en República Dominicana para No Residentes y Extranjeros"
  metaDescripcion="Descubre cómo financiar la compra de tu casa o villa en República Dominicana viviendo en EE. UU., España o cualquier parte del mundo. Requisitos, bancos y plazos."
  categoria="Financiamiento & Bancos"
  tiempoLectura="6 min"
  fechaActualizacion="2026-08-24"
>

  <!-- ─── ÍNDICE INTERACTIVO DE CONTENIDO ─── -->
  <IndiceContenido items={itemsIndice} />

  <!-- ═══════════════════════════════════════════════════════════════
       SECCIÓN 1 — ¿Puedo Calificar siendo Extranjero?
       ═══════════════════════════════════════════════════════════════ -->
  <section id="puedo-calificar" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 01</span>
      <span>•</span>
      <span>Acceso al Crédito</span>
    </div>
    <h2>1. ¿Un extranjero o dominicano en el exterior puede solicitar hipoteca en RD?</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> La banca dominicana cuenta con departamentos internacionales para financiar hasta el 80% del valor del inmueble a compradores extranjeros y miembros de la diáspora.
    </div>

    <p>
      No necesitas ser residente ni tener historial bancario previo en el país. Las entidades financieras dominicanas evalúan tus ingresos y tu reporte crediticio en tu país de residencia habitual (EE. UU., España, Canadá o Europa).
    </p>

    <!-- Métricas del préstamo -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-5">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-center">
        <span class="text-3xl font-black text-navy block">Hasta 80%</span>
        <span class="text-xs font-bold uppercase text-gold block mt-1">Financiamiento (LTV)</span>
        <p class="text-[11px] text-slate-500 mt-1">Calculado sobre el valor de tasación oficial del inmueble.</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-center">
        <span class="text-3xl font-black text-navy block">Hasta 20 Años</span>
        <span class="text-xs font-bold uppercase text-gold block mt-1">Plazo en Dólares</span>
        <p class="text-[11px] text-slate-500 mt-1">Y hasta 25 años en préstamos denominados en Pesos (DOP).</p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-center">
        <span class="text-3xl font-black text-navy block">USD o DOP</span>
        <span class="text-xs font-bold uppercase text-gold block mt-1">Moneda del Préstamo</span>
        <p class="text-[11px] text-slate-500 mt-1">Pagas tu cuota mensual en la moneda de tus ingresos habituales.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECCIÓN 2 — Documentación Requerida
       ═══════════════════════════════════════════════════════════════ -->
  <section id="requisitos-documentos" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 02</span>
      <span>•</span>
      <span>Expediente Financiero</span>
    </div>
    <h2>2. Documentación y Requisitos para la Precalificación</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> El trámite es 100% digital. Solo necesitas enviar tus declaraciones de impuestos en origen, estados de cuenta bancarios y tu reporte de crédito internacional.
    </div>

    <!-- Lista de verificación -->
    <div class="space-y-3 my-4">
      <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-100 flex items-start gap-3">
        <span class="w-6 h-6 rounded-lg bg-gold/15 text-gold flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
        </span>
        <div>
          <strong class="text-xs sm:text-sm text-navy block">Identificación Oficial:</strong>
          <span class="text-xs text-slate-600 leading-relaxed block mt-0.5">Copia del Pasaporte extranjero vigente y/o Cédula Dominicana de Identidad para ciudadanos en el exterior.</span>
        </div>
      </div>

      <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-100 flex items-start gap-3">
        <span class="w-6 h-6 rounded-lg bg-gold/15 text-gold flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
        </span>
        <div>
          <strong class="text-xs sm:text-sm text-navy block">Comprobación de Ingresos (Tax Returns):</strong>
          <span class="text-xs text-slate-600 leading-relaxed block mt-0.5">Últimas 2 declaraciones de renta (Formularios W-2 / 1040 en EE. UU., IRPF en España o T4 en Canadá).</span>
        </div>
      </div>

      <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-100 flex items-start gap-3">
        <span class="w-6 h-6 rounded-lg bg-gold/15 text-gold flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-6 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" /></svg>
        </span>
        <div>
          <strong class="text-xs sm:text-sm text-navy block">Estados de Cuenta Bancarios:</strong>
          <span class="text-xs text-slate-600 leading-relaxed block mt-0.5">Extractos bancarios oficiales de los últimos 6 meses en tu país de residencia habitual.</span>
        </div>
      </div>

      <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-100 flex items-start gap-3">
        <span class="w-6 h-6 rounded-lg bg-gold/15 text-gold flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        </span>
        <div>
          <strong class="text-xs sm:text-sm text-navy block">Reporte de Crédito Internacional:</strong>
          <span class="text-xs text-slate-600 leading-relaxed block mt-0.5">Informe crediticio vigente emitido por burós oficiales (Equifax, TransUnion, Experian o CIRBE).</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECCIÓN 3 — Principales Bancos en RD
       ═══════════════════════════════════════════════════════════════ -->
  <section id="bancos-autorizados" class="guia-modulo scroll-mt-28">
    <div class="flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-widest mb-1.5">
      <span>Módulo 03</span>
      <span>•</span>
      <span>Entidades Financieras</span>
    </div>
    <h2>3. Principales Entidades Bancarias en República Dominicana</h2>

    <!-- Resumen ejecutivo -->
    <div class="bg-gold/10 border-l-3 border-gold rounded-r-xl p-3.5 mb-6 text-xs sm:text-sm text-navy font-medium leading-relaxed">
      <strong>Resumen ejecutivo:</strong> En Alexis RD Real Estate gestionamos tu expediente directamente con los ejecutivos hipotecarios de los 4 bancos líderes del país.
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 my-4">
      <div class="p-4 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-1.5">
        <h4 class="font-bold text-navy text-sm">Banco Banreservas</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Líder en créditos para la diáspora con oficinas de representación en Madrid, Nueva York y Miami.</p>
      </div>

      <div class="p-4 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-1.5">
        <h4 class="font-bold text-navy text-sm">Banco BHD</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Especialistas en financiamiento de proyectos turísticos en planos y apartamentos vacacionales en Punta Cana.</p>
      </div>

      <div class="p-4 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-1.5">
        <h4 class="font-bold text-navy text-sm">Banco Popular Dominicano</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Amplia experiencia en hipotecas en USD para compradores extranjeros con tasas fijas preferenciales.</p>
      </div>

      <div class="p-4 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-1.5">
        <h4 class="font-bold text-navy text-sm">APAP (Asociación Popular)</h4>
        <p class="text-xs text-slate-500 leading-relaxed">Plazos flexibles de hasta 25 años y excelentes condiciones para adquisición de primera o segunda vivienda.</p>
      </div>
    </div>

    <CajaAlertaJuridica tipo="info" titulo="Precalificación Sin Compromiso">
      El trámite de precalificación inicial toma entre <strong>3 y 5 días hábiles</strong> y te permite conocer con exactitud tu capacidad máxima de compra antes de realizar cualquier reserva de unidad.
    </CajaAlertaJuridica>
  </section>

  <!-- Banner WhatsApp contextualizado -->
  <BannerWhatsappGuia
    badge="Gestión Hipotecaria"
    titulo="¿Deseas precalificar para un préstamo bancario en RD?"
    subtitulo="Te asesoramos sin costo en la recopilación de tu expediente bancario y lo canalizamos con las mejores tasas del mercado dominicano."
    mensaje="Hola Alexis, deseo precalificar para un préstamo hipotecario en RD viviendo fuera del país. ¿Me puedes asesorar?"
  />

</GuiaLayout>
