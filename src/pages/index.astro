---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import { Image } from 'astro:assets';
import logoEmpresa from '../assets/images/logo-alexis-rd.png';
import fallbackImage from '../assets/images/prueba-inmobiliaria.jpg';
import { slugify } from '../utils/slugify';
import { resolverPrecios } from '../utils/currency';

const WHATSAPP_PHONE = "18295259993";

const imagenes = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP}', { eager: true });

// Tomamos solo las primeras 3 propiedades para la sección de featured cards
const modulosJSON = import.meta.glob('/src/content/propiedades/**/*.json', { eager: true });
const featuredProps = Object.entries(modulosJSON).slice(0, 3).map(([ruta, modulo]) => {
  const c = modulo as any;
  const id = slugify(ruta.split('/').pop()?.replace('.json', '') || 'property');
  const { usd: precioUsd, dop: precioDop } = resolverPrecios(c.precioUsd, c.precioDop);
  // Use raw id for URL - [id].astro uses getEntry which needs the exact Keystatic entry id
  
  const rutaRaw = String(c.imagenPrincipal || '');
  const imagenPublica = rutaRaw ? rutaRaw.replace(/^\.\.\/\.\.\//, '/src/') : '';
  const imgMeta = imagenes[imagenPublica]?.default || fallbackImage;

    const cleanUbicacion = c.ubicacion ? String(c.ubicacion).replace(/\b\w/g, char => char.toUpperCase()) : 'República Dominicana';

    return { 
      id, 
      titulo: c.titulo || id, 
      ubicacion: cleanUbicacion, 
      precioUsd,
      precioDop, 
      tipo: c.tipo || 'Propiedad', 
      imagenPrincipal: c.imagenPrincipal || '', 
      imagenMetadata: imgMeta,
      estado: c.estado || '' 
    };
});

const stats = [
  { value: '150+', label: 'Propiedades vendidas' },
  { value: '12+', label: 'Años de experiencia' },
  { value: '98%', label: 'Clientes satisfechos' },
  { value: '$50M+', label: 'En transacciones' },
];
---

<!DOCTYPE html>
