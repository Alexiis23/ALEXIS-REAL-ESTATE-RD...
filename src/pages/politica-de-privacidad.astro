---
// src/pages/politica-de-privacidad.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
---

<!DOCTYPE html>
<html lang="es" class="bg-offwhite text-slate-900">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Política de Privacidad | Alexis Real Estate RD</title>
  <meta name="description" content="Política de Privacidad y Protección de Datos de Alexis Real Estate RD. Cumplimiento de la Ley 172-13 de República Dominicana sobre datos personales." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col font-sans">

  <Navbar lang="es" currentPage="privacidad" />

  <!-- ─── HERO ─────────────────────────── -->
  <section class="relative overflow-hidden pt-28 pb-14">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"></div>
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 left-1/3 w-96 h-64 bg-gold/6 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
      <span class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Protección de Datos
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight tracking-tight font-display">
        Política de <span class="text-gold">Privacidad</span>
      </h1>
      <p class="mt-4 text-white/60 text-base max-w-2xl mx-auto leading-relaxed">
        Cómo recopilamos, usamos y protegemos tus datos personales conforme a la Ley 172-13.
      </p>
    </div>
  </section>

  <!-- ─── CONTENT ─────────────────────────── -->
  <main class="flex-1 -mt-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="bg-white rounded-2xl shadow-xl shadow-navy/5 border border-slate-100 overflow-hidden">

        <!-- 1. Cumplimiento Legal -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">1</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Cumplimiento Legal (Ley No. 172-13)</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                En cumplimiento de la Ley No. 172-13 sobre Protección de Datos de Carácter Personal de la República Dominicana, Alexis Real Estate RD informa que los datos suministrados voluntariamente por los usuarios a través de formularios web o enlaces de WhatsApp serán tratados de manera confidencial y con las máximas garantías de seguridad.
              </p>
              <!-- Badge -->
              <div class="mt-4 inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 text-xs font-semibold px-4 py-2 rounded-full border border-emerald-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                Ley 172-13 · República Dominicana
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Datos Recopilados -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">2</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Datos Recopilados</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Podemos recopilar y procesar la siguiente información personal cuando el usuario decide contactarnos:
              </p>
              <ul class="mt-4 space-y-2.5">
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Nombre y apellido.
                </li>
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Dirección de correo electrónico.
                </li>
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Número de teléfono o WhatsApp.
                </li>
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Preferencias o consultas sobre propiedades específicas.
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 3. Finalidad del Tratamiento de Datos -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">3</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Finalidad del Tratamiento de Datos</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Los datos personales capturados se utilizan exclusivamente para:
              </p>
              <ul class="mt-4 space-y-2.5">
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Responder a las consultas enviadas sobre las propiedades publicadas.
                </li>
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Enviar información actualizada sobre inmuebles, proyectos en planos u oportunidades de inversión de interés para el cliente.
                </li>
                <li class="flex items-start gap-3 text-sm text-slate-600">
                  <span class="flex-shrink-0 w-5 h-5 rounded-md bg-navy/5 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Coordinar citas y visitas presenciales o virtuales a las propiedades.
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 4. Cesión de Datos a Terceros -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">4</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Cesión de Datos a Terceros</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Alexis Real Estate RD no vende, alquila ni comparte los datos personales de sus usuarios con terceros con fines publicitarios ajenos. Los datos solo podrán ser compartidos con desarrolladores inmobiliarios o firmas legales en caso de que el cliente inicie formalmente un proceso de reserva o compraventa.
              </p>
            </div>
          </div>
        </div>

        <!-- 5. Derechos de Acceso, Rectificación y Supresión -->
        <div class="p-8 sm:p-10">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">5</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Derechos de Acceso, Rectificación y Supresión</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                El usuario tiene derecho a solicitar el acceso a sus datos personales, corregir información inexacta o pedir la eliminación completa de sus registros de nuestras bases de datos en cualquier momento. Para ejercer este derecho, puede enviar una solicitud a:
              </p>
              <!-- Contact card -->
              <div class="mt-5 bg-slate-50 rounded-xl p-5 border border-slate-100 inline-flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gold/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-slate-500 font-medium">Correo de contacto</p>
                  <a href="mailto:alexisre.rd@gmail.com" class="text-sm font-semibold text-gold hover:text-gold/80 transition-colors underline underline-offset-2">
                    alexisre.rd@gmail.com
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Back link -->
      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-navy/60 hover:text-gold transition-colors duration-200 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </main>

  <Footer lang="es" />
  <AccessibilityWidget />
</body>
</html>
