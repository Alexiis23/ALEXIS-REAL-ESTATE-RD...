---
import { getCollection, getEntry } from "astro:content";
import "../../styles/global.css";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AccessibilityWidget from "../../components/AccessibilityWidget.astro";
import { Image } from "astro:assets";
import * as deepl from "deepl-node";

const { id } = Astro.params;

// Intentar recuperar directamente por ID primero
let entry = await getEntry("propiedades", id || "");

// Si no se encuentra (debido a diferencias de casing/slug en Keystatic), buscamos en la colección por slug
if (!entry && id) {
  const todas = await getCollection("propiedades");
  entry = todas.find((item) => {
    const slugSeguro = item.id
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]/g, "-");
    return slugSeguro === id;
  });
}

if (!entry) {
  return Astro.redirect("/404");
}

const idPropiedad = entry.id;

// 2. CONFIGURAR VARIABLES DE TEXTO INMEDIATAMENTE
const tituloOriginal = entry.data.titulo || idPropiedad.replace(/-/g, " ");
const descripcionOriginal =
  entry.data.descripcion || "Descubre esta increíble oportunidad inmobiliaria.";
const tipoOriginal = entry.data.tipo || "Apartamento";
const estadoOriginal = entry.data.estado || "En planos";

let titulo = tituloOriginal;
let descripcion = descripcionOriginal;
let tipo = tipoOriginal;
let estado = estadoOriginal;

const precio = Number(entry.data.precio) || 0;
const ubicacion = entry.data.ubicacion || "República Dominicana";
const confotur = Boolean(entry.data.confotur);
const habitaciones = Number(entry.data.habitaciones) || 0;
const banos = Number(entry.data.banos) || 0;
const parqueos = Number(entry.data.parqueos) || 0;
const latitud = Number(entry.data.latitud) || 18.47186;
const longitud = Number(entry.data.longitud) || -69.89232;

// 3. RESOLVER IMÁGENES Y GALERÍA (Con casting "as any[]" para silenciar TypeScript de forma segura)
const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,WEBP}",
  { eager: true },
);
const dataPlana = entry.data as any;
const galeriaRaw = dataPlana.galeria || [];

const fotosGaleria = galeriaRaw
  .map((rutaRaw: string) => {
    const rutaPublica = String(rutaRaw || "").replace(/^\.\.\/\.\.\//, "/src/");
    return imagenes[rutaPublica]?.default || null;
  })
  .filter(Boolean) as any[];

const rutaPrincipal = String(entry.data.imagenPrincipal || "").replace(/^\.\.\/\.\.\//, "/src/");
const imagenPrincipalResuelta = imagenes[rutaPrincipal]?.default || null;

// 4. CONFIGURACIÓN DE LA API DE TRADUCCIÓN (DEEPL SHIELD)
const DEEPL_AUTH_KEY = "cfcc4e7f-2356-4f78-a8e3-3bc2bc6aafb4:fx";
let translator: any = null;

try {
  if (DEEPL_AUTH_KEY) {
    translator = new deepl.Translator(DEEPL_AUTH_KEY);
  }
} catch (e) {
  console.error("Error al inicializar el traductor en detalle:", e);
}

const WHATSAPP_PHONE = "18295259993";
---

<!doctype html>
<html lang="es" class="bg-offwhite text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 1. El Título de la pestaña en Google (Español) -->
    <title>{tituloOriginal} | Alexis RD Real Estate</title>

    <!-- 2. La descripción para buscadores en Español -->
    <meta
      name="description"
      content={`Exclusiva propiedad en ${ubicacion}. Precio: USD $${precio.toLocaleString("en-US")}. Habitaciones: ${habitaciones} | Baños: ${banos}. Ver detalles, fotos y mapa de ubicación.`}
    />

    <!-- 3. Metadatos de Redes Sociales y WhatsApp en Español (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={`${tituloOriginal} | Alexis RD Real Estate`}
    />
    <meta
      property="og:description"
      content={`Oportunidad de Inversión en ${ubicacion}. Precio: USD $${precio.toLocaleString("en-US")}. Haz clic para ver todos los detalles y fotos.`}
    />

    <!-- Imagen de miniatura para compartir por WhatsApp -->
    <meta
      property="og:image"
      content={String(entry.data.imagenPrincipal || "").replace(
        "../../",
        "/src/",
      )}
    />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Leaflet Assets (Mapas) -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
      is:inline></script>
  </head>

  <body class="min-h-screen flex flex-col bg-offwhite">
    <Navbar lang="es" />

    <main
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-10 flex-1 w-full"
    >
      <!-- Breadcrumb de Regreso -->
      <div class="mb-6">
        <a
          href="/"
          class="text-sm text-warm-gray hover:text-gold transition-colors flex items-center gap-2 font-medium"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al catálogo
        </a>
      </div>

      <!-- Encabezado de la Propiedad -->
      <div class="border-b border-slate-200 pb-6 mb-8">
        <div
          class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider mb-3"
        >
          <span class="bg-navy text-gold px-2.5 py-1 rounded">{tipo}</span>
          <span class="bg-gold text-navy px-2.5 py-1 rounded">{estado}</span>
          {
            confotur && (
              <span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded border border-emerald-200">
                ✓ Beneficio Confotur
              </span>
            )
          }
        </div>
        <h1
          class="text-3xl font-extrabold text-navy sm:text-4xl tracking-tight leading-tight"
        >
          {titulo}
        </h1>
        <p class="mt-2 text-lg text-warm-gray flex items-center gap-1.5">
          <svg
            class="w-5 h-5 text-gold"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path>
          </svg>
          {ubicacion}
        </p>
      </div>

      <!-- Grid de Contenido Principal -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- COLUMNA IZQUIERDA: Multimedia, Galería y Descripción -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Contenedor Multimedia Principal -->
          <div class="space-y-6">
            <div
              class="w-full rounded-xl overflow-hidden bg-slate-100 shadow-sm relative aspect-video md:aspect-[21/9]"
            >
              {
                imagenPrincipalResuelta ? (
                  <Image
                    src={imagenPrincipalResuelta}
                    alt={titulo}
                    width={1200}
                    height={514}
                    format="webp"
                    loading="eager"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center bg-slate-100 text-slate-400">
                    <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-xs font-semibold">Sin imagen disponible</span>
                  </div>
                )
              }
            </div>

            <!-- Galería de fotos secundarias -->
            {
              fotosGaleria.length > 0 && (
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                  <h3 class="text-xl font-bold text-navy mb-4 border-b border-slate-100 pb-2">
                    Galería de Fotos
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    {fotosGaleria.map((imgMeta, index) => (
                      <div class="aspect-video overflow-hidden rounded-xl border border-slate-200 shadow-sm group cursor-pointer">
                        <Image
                          src={imgMeta}
                          alt={`Foto ${index + 1} de ${tituloOriginal}`}
                          format="webp"
                          quality={75}
                          class="object-cover w-full h-full hover:scale-105 transition-transform duration-200"
                        />
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <!-- Descripción -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h2
              class="text-xl font-bold text-navy mb-4 border-b border-slate-100 pb-2"
            >
              Descripción de la Propiedad
            </h2>
            <p
              class="text-slate-600 leading-relaxed text-base whitespace-pre-line"
            >
              {descripcion}
            </p>
          </div>
        </div>

        <!-- COLUMNA DERECHA: Conversión, Características, Mapa y Calculadora -->
        <div class="space-y-6">
          <!-- Tarjeta de Precio y WhatsApp Directo -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-center"
          >
            <span
              class="text-xs font-bold text-warm-gray uppercase tracking-widest"
              >Precio de Venta</span
            >
            <div class="text-3xl font-black text-navy mt-1 mb-6">
              USD ${precio.toLocaleString("en-US")}
            </div>
            <a
              href={`https://wa.me/${WHATSAPP_PHONE}?text=Hola%20Alexis,%20solicito%20atención%20personalizada%20y%20detalles%20financieros%20para%20la%20propiedad:%20"${encodeURIComponent(titulo)}".`}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3.5 rounded-xl text-sm transition-colors shadow-md text-center flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              Agendar Cita por WhatsApp
            </a>
          </div>

          <!-- Formulario HTML -->
          <form id="contact-form" class="space-y-4">
            <!-- Datos ocultos para enriquecer el correo dinámicamente -->
            <input
              type="hidden"
              name="property_title"
              value={entry.data.titulo}
            />
            <input type="hidden" name="property_url" value={Astro.url.href} />
            <input
              type="hidden"
              name="form_type"
              value="Consulta de Propiedad"
            />

            <div>
              <label
                class="block text-xs font-bold text-slate-300 uppercase mb-1"
                >Nombre Completo</label
              >
              <input
                type="text"
                name="name"
                required
                class="w-full bg-[#112036] border border-slate-700 rounded-lg p-3 text-white text-sm focus:border-[#C9A84C] outline-none"
                placeholder="Ej. Juan Pérez"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-slate-300 uppercase mb-1"
                >Correo</label
              >
              <input
                type="email"
                name="email"
                required
                class="w-full bg-[#112036] border border-slate-700 rounded-lg p-3 text-white text-sm focus:border-[#C9A84C] outline-none"
                placeholder="juan@correo.com"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-slate-300 uppercase mb-1"
                >Teléfono</label
              >
              <input
                type="tel"
                name="phone"
                required
                class="w-full bg-[#112036] border border-slate-700 rounded-lg p-3 text-white text-sm focus:border-[#C9A84C] outline-none"
                placeholder="829-555-5555"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-slate-300 uppercase mb-1"
                >Mensaje</label
              >
              <textarea
                name="message"
                rows="3"
                required
                class="w-full bg-[#112036] border border-slate-700 rounded-lg p-3 text-white text-sm focus:border-[#C9A84C] outline-none"
                placeholder="Hola Alexis, me gustaría recibir más información..."
              ></textarea>
            </div>

            <!-- Botón interactivo con micro-ajustes físicos de Tailwind -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-[#0B192C] border border-[#C9A84C]/20 text-white font-bold py-3 px-4 rounded-xl text-sm
                    transition-all duration-300 ease-in-out
                    hover:bg-[#C9A84C] hover:text-[#0B192C] hover:shadow-lg hover:shadow-[#C9A84C]/25
                    active:scale-[0.98] focus:outline-none"
            >
              ENVIAR MENSAJE POR CORREO
            </button>
          </form>

          <!-- Banners de respuesta (Inicialmente ocultos) -->
          <div
            id="success-banner"
            class="hidden mt-4 p-4 bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-sm rounded-xl flex items-center gap-2"
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l5-5z"
                clip-rule="evenodd"></path></svg
            >
            <span
              >¡Gracias! Tu mensaje ha sido enviado con éxito de forma interna.</span
            >
          </div>

          <div
            id="error-banner"
            class="hidden mt-4 p-4 bg-rose-500/10 border border-rose-500/30 text-rose-300 text-sm rounded-xl flex items-center gap-2"
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              ><path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                clip-rule="evenodd"></path></svg
            >
            <span
              >Ocurrió un error al enviar. Por favor, inténtalo de nuevo o
              escríbenos por WhatsApp.</span
            >
          </div>

          <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
              const form = document.getElementById("contact-form");
              const submitBtn = document.getElementById("submit-btn");
              const successBanner = document.getElementById("success-banner");
              const errorBanner = document.getElementById("error-banner");

              if (form) {
                form.addEventListener("submit", async (e) => {
                  e.preventDefault();

                  // 1. Efecto visual de carga
                  submitBtn.disabled = true;
                  const originalText = submitBtn.textContent;
                  submitBtn.textContent = "ENVIANDO...";
                  submitBtn.style.opacity = "0.7";

                  // Ocultar banners anteriores
                  successBanner.classList.add("hidden");
                  errorBanner.classList.add("hidden");

                  const formData = new FormData(form);

                  try {
                    // 2. Apuntar directamente a tu nuevo API Endpoint local 🚀
                    const response = await fetch("/api/contacto", {
                      method: "POST",
                      body: formData,
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                      // 3. Éxito: Limpiamos y ocultamos el formulario
                      form.reset();
                      successBanner.classList.remove("hidden");
                      form.classList.add("hidden");
                    } else {
                      errorBanner.classList.remove("hidden");
                    }
                  } catch (err) {
                    errorBanner.classList.remove("hidden");
                  } finally {
                    // 4. Restaurar botón
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalText;
                    submitBtn.style.opacity = "1";
                  }
                });
              }
            });
          </script>
          <!-- Características Físicas -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h3
              class="font-bold text-navy mb-4 text-sm uppercase tracking-wider text-center sm:text-left"
            >
              Características
            </h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center"
              >
                <svg
                  class="w-6 h-6 text-gold mx-auto"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"
                  ></path>
                </svg>
                <span class="block font-bold text-navy mt-1"
                  >{habitaciones} Hab</span
                >
              </div>
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center"
              >
                <svg
                  class="w-6 h-6 text-gold mx-auto"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4"></path>
                </svg>
                <span class="block font-bold text-navy mt-1">{banos} Baños</span
                >
              </div>
              <div
                class="bg-offwhite p-3 rounded-xl border border-slate-100 text-center col-span-2"
              >
                <span class="font-semibold text-warm-gray"
                  >Parqueos disponibles:</span
                >
                <span class="font-bold text-navy ml-1">{parqueos}</span>
              </div>
            </div>
          </div>

          <!-- Ubicación -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h2
              class="text-sm font-bold text-navy uppercase tracking-wider mb-4 border-b border-slate-100 pb-2 flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-gold"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path>
              </svg>
              Ubicación de la Propiedad
            </h2>
            <div
              id="map-individual"
              class="w-full h-64 rounded-xl border border-slate-200 shadow-inner z-10"
            >
            </div>
          </div>

          <!-- Calculadora -->
          <div
            class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm"
          >
            <h3
              class="text-lg font-bold text-navy mb-1 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5 text-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
              Inversión Inteligente
            </h3>
            <p class="text-xs text-warm-gray mb-4">
              Planifica tu presupuesto de cierre estimado.
            </p>

            <div class="space-y-4">
              <div>
                <div
                  class="flex justify-between text-xs font-semibold text-slate-700 mb-1"
                >
                  <label for="range-inicial">Porcentaje de Inicial:</label>
                  <span id="display-porcentaje" class="text-gold font-bold"
                    >20%</span
                  >
                </div>
                <input
                  type="range"
                  id="range-inicial"
                  min="20"
                  max="100"
                  step="5"
                  value="20"
                  class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-gold"
                />
              </div>

              <div
                class="bg-offwhite rounded-xl p-4 border border-slate-100 space-y-3 text-xs"
              >
                <div
                  class="flex justify-between border-b border-slate-200 pb-2"
                >
                  <span class="text-slate-600">Monto Inicial:</span>
                  <span class="font-bold text-navy" id="calc-inicial"
                    >USD $0</span
                  >
                </div>
                <div
                  class="flex justify-between border-b border-slate-200 pb-2"
                >
                  <span class="text-slate-600">Monto Hipotecario:</span>
                  <span class="font-bold text-navy" id="calc-prestamo"
                    >USD $0</span
                  >
                </div>
                <div class="flex flex-col gap-1 pt-1">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-600">Impuesto 3% DGII:</span>
                    <span class="font-bold text-navy" id="calc-dgii"
                      >USD $0</span
                    >
                  </div>
                  {
                    confotur && (
                      <span class="self-start bg-emerald-100 text-emerald-800 text-[10px] font-bold px-1.5 py-0.5 rounded mt-1">
                        ✓ Ahorro por Ley Confotur
                      </span>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer lang="es" />
    <AccessibilityWidget lang="es" />

    <!-- LÓGICA DE CONTROLADORES -->
    <script
      is:inline
      define:vars={{
        lat: latitud,
        lng: longitud,
        titulo: titulo,
        precioPropiedad: precio,
        tieneConfotur: confotur,
      }}
    >
      const initProptechModules = () => {
        const mapaContenedor = document.getElementById("map-individual");
        if (mapaContenedor && typeof L !== "undefined") {
          const validLat = Number(lat) || 18.4231;
          const validLng = Number(lng) || -69.4124;

          const map = L.map("map-individual").setView([validLat, validLng], 14);

          L.tileLayer(
            "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
            {
              attribution:
                '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            },
          ).addTo(map);

          const marker = L.marker([validLat, validLng]).addTo(map);
          marker
            .bindPopup(
              `<b style="font-family: 'Inter', sans-serif; color: #0B192C;">${titulo}</b>`,
            )
            .openPopup();

          setTimeout(() => {
            map.invalidateSize();
          }, 300);
        }

        const rangeInicial = document.getElementById("range-inicial");
        const displayPorcentaje = document.getElementById("display-porcentaje");
        const calcInicial = document.getElementById("calc-inicial");
        const calcPrestamo = document.getElementById("calc-prestamo");
        const calcDgii = document.getElementById("calc-dgii");

        if (
          rangeInicial &&
          displayPorcentaje &&
          calcInicial &&
          calcPrestamo &&
          calcDgii
        ) {
          function calcular() {
            const porcentaje = parseInt(rangeInicial.value, 10);
            displayPorcentaje.textContent = `${porcentaje}%`;

            const inicial = precioPropiedad * (porcentaje / 100);
            const prestamo = precioPropiedad - inicial;
            const impuestoDGII = tieneConfotur ? 0 : precioPropiedad * 0.03;

            calcInicial.textContent = `USD $${Math.round(inicial).toLocaleString("en-US")}`;
            calcPrestamo.textContent = `USD $${Math.round(prestamo).toLocaleString("en-US")}`;
            calcDgii.textContent =
              impuestoDGII === 0
                ? "EXENTO"
                : `USD $${Math.round(impuestoDGII).toLocaleString("en-US")}`;
          }

          rangeInicial.addEventListener("input", calcular);
          calcular();
        }

        // --- MANEJADOR DE FORMULARIO DE CONTACTO AJAX ---
        const contactForm = document.getElementById("contact-form");
        const feedback = document.getElementById("form-feedback");
        if (contactForm && feedback) {
          contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = contactForm.querySelector(
              "button[type='submit']",
            );
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = "Enviando...";
            submitBtn.style.opacity = "0.7";
            feedback.classList.add("hidden");
            feedback.className =
              "p-4 rounded-xl text-xs font-semibold text-center mt-3";

            try {
              const res = await fetch(contactForm.action, {
                method: contactForm.method,
                body: new FormData(contactForm),
                headers: {
                  Accept: "application/json",
                },
              });
              if (res.ok) {
                contactForm.reset();
                const formFields = contactForm.querySelector("#form-fields");
                if (formFields) formFields.classList.add("hidden");
                feedback.innerHTML = `<span class="flex items-center justify-center gap-1.5 font-bold">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  ¡Gracias! Tu mensaje ha sido enviado con éxito.
                </span>`;
                feedback.classList.remove("hidden");
                feedback.classList.add(
                  "bg-emerald-500/10",
                  "border",
                  "border-emerald-500/30",
                  "text-emerald-500",
                );
              } else {
                throw new Error();
              }
            } catch (err) {
              feedback.innerHTML = `<span class="flex items-center justify-center gap-1.5 text-rose-800">
                <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Ocurrió un error. Por favor, reintente o contáctenos vía WhatsApp.
              </span>`;
              feedback.classList.remove("hidden");
              feedback.classList.add("bg-rose-50", "border", "border-rose-200");
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
              submitBtn.style.opacity = "";
            }
          });
        }
      };

      document.addEventListener("DOMContentLoaded", initProptechModules);
      document.addEventListener("astro:page-load", initProptechModules);
    </script>
  </body>
</html>
