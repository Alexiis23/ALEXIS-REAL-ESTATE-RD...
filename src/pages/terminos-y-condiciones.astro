---
// src/pages/terminos-y-condiciones.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
---

<!DOCTYPE html>
<html lang="es" class="bg-offwhite text-slate-900">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Términos y Condiciones | Alexis Real Estate RD</title>
  <meta name="description" content="Términos y Condiciones de uso del sitio web de Alexis Real Estate RD. Información sobre propiedades, exención de responsabilidad y legislación aplicable." />
</head>
<body class="min-h-screen flex flex-col font-sans">

  <Navbar lang="es" currentPage="terminos" />

  <!-- ─── HERO ─────────────────────────── -->
  <section class="relative overflow-hidden pt-28 pb-14">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-[#0a1f38] to-[#071627]"></div>
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-64 bg-gold/6 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
      <span class="inline-flex items-center gap-2 bg-gold/15 text-gold text-xs font-bold uppercase tracking-[0.2em] px-5 py-2 rounded-full border border-gold/25 mb-5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        Condiciones de Uso
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-white leading-tight tracking-tight font-display">
        Términos y <span class="text-gold">Condiciones</span>
      </h1>
      <p class="mt-4 text-white/60 text-base max-w-2xl mx-auto leading-relaxed">
        Condiciones que regulan el uso del sitio web y la información inmobiliaria publicada.
      </p>
    </div>
  </section>

  <!-- ─── CONTENT ─────────────────────────── -->
  <main class="flex-1 -mt-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="bg-white rounded-2xl shadow-xl shadow-navy/5 border border-slate-100 overflow-hidden">

        <!-- 1. Naturaleza de la Información Inmobiliaria -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">1</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Naturaleza de la Información Inmobiliaria</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Toda la información relativa a las propiedades publicadas en el Sitio Web (precios en USD/DOP, metros cuadrados, distribución, amenidades, ubicación de referencia y disponibilidad) se muestra con fines estrictamente informativos y comerciales.
              </p>

              <!-- Sub-sections -->
              <div class="mt-5 space-y-4">
                <div class="bg-slate-50 rounded-xl p-5 border border-slate-100">
                  <h3 class="text-sm font-semibold text-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Precios y Disponibilidad
                  </h3>
                  <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                    Los precios de venta y alquiler, así como la disponibilidad de los inmuebles o unidades en proyectos en planos, pueden cambiar sin previo aviso por decisión de los propietarios o desarrolladores.
                  </p>
                </div>

                <div class="bg-slate-50 rounded-xl p-5 border border-slate-100">
                  <h3 class="text-sm font-semibold text-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Proyectos en Planos y Renders
                  </h3>
                  <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                    Las imágenes, renders 3D, planos constitutivos y proyecciones de retorno de inversión (ROI) presentadas en propiedades en planos o fase de construcción son representaciones artísticas orientativas y pueden sufrir variaciones durante la ejecución de la obra.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Exención de Responsabilidad Comercial y Financiera -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">2</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Exención de Responsabilidad Comercial y Financiera</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Las publicaciones en el Sitio Web no constituyen una oferta vinculante ni un compromiso de financiamiento bancario directo. Alexis Real Estate RD actúa como intermediario inmobiliario y asesora en la gestión de compraventa o alquiler, pero no garantiza la aprobación de préstamos hipotecarios ni la exención de impuestos finales, los cuales dependen de las entidades bancarias y de la Dirección General de Impuestos Internos (DGII) de la República Dominicana.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Uso Aceptable del Sitio -->
        <div class="p-8 sm:p-10 border-b border-slate-100">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">3</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Uso Aceptable del Sitio</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                El usuario se compromete a no utilizar el Sitio Web para realizar actividades ilícitas, enviar spam mediante los formularios de contacto o intentar alterar la seguridad y el código del portal.
              </p>
            </div>
          </div>
        </div>

        <!-- 4. Legislación Aplicable y Jurisdicción -->
        <div class="p-8 sm:p-10">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gold/10 text-gold text-sm font-bold flex items-center justify-center">4</span>
            <div>
              <h2 class="text-lg font-bold text-navy tracking-tight">Legislación Aplicable y Jurisdicción</h2>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                Los presentes Términos y Condiciones se rigen por las leyes de la República Dominicana. Para cualquier controversia o conflicto legal derivado del uso de este sitio, las partes se someten a la jurisdicción de los tribunales correspondientes de la República Dominicana.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Back link -->
      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-navy/60 hover:text-gold transition-colors duration-200 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </main>

  <Footer lang="es" />
  <AccessibilityWidget />
</body>
</html>
